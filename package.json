{
  "name": "writty",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:sync": "chokidar \"src/content/**/*\" -i \"**/.DS_Store\" -i \"**/.git/**\" -c \"pnpm astro sync\"",
    "dev:with-sync": "concurrently -n sync,dev -c cyan,green \"pnpm dev:sync\" \"pnpm dev\"",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "enrich:tmdb": "NODE_OPTIONS=--dns-result-order=ipv4first tsx scripts/enrich-tmdb.ts",
    "enrich:actors": "NODE_OPTIONS=--dns-result-order=ipv4first tsx scripts/enrich-actors.ts",
    "tmdb": "pnpm run enrich:tmdb && pnpm run enrich:actors"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.5.0",
    "@astrojs/check": "^0.9.8",
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/netlify": "^7.0.6",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "@types/alpinejs": "^3.13.11",
    "@types/mdast": "^4.0.4",
    "alpinejs": "^3.15.10",
    "astro": "^6.0.8",
    "dotenv": "^17.3.1",
    "gray-matter": "^4.0.3",
    "mdast": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "remark": "^15.0.1",
    "sharp": "^0.34.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1"
  }
}