---
import fs from 'node:fs/promises';
import path from 'node:path';
import matter from 'gray-matter';
import IndexLayout from "../../layouts/IndexLayout.astro";
import ActorCard from "../../components/collection-cards/ActorCard.astro";
import ActorCreateForm from "../../components/actors/ActorCreateForm.astro";

export const prerender = false;

/**
 * Reads all actors .mdx files directly from disk at request time.
 * Bypasses Astro's content store, which is stale between SSR requests.
 * Shaped like CollectionEntry so downstream components need no changes.
 */
const collectionDir = path.resolve(process.cwd(), 'src/content/actors');
const files = await fs.readdir(collectionDir);

const actors = (
  await Promise.all(
    files
      .filter(f => f.endsWith('.md') || f.endsWith('.mdx'))
      .map(async (file) => {
        const raw = await fs.readFile(path.join(collectionDir, file), 'utf-8');
        const { data } = matter(raw);
        const id = file.replace(/\.(md|mdx)$/, '');
        return { 
          id, 
          data: data as any,
          collection: "actors" as const 
        };
      })
  )
).sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<IndexLayout
  title="Actors"
  count={actors.length}
  description="Actor profiles and filmography."
>
  <ActorCreateForm />
  
  {actors.length === 0 ? (
    <p class="empty">No actors yet.</p>
  ) : (
    <ul class="grid grid--cols-4">
      {actors.map((entry) => (
        <li>
          <ActorCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-4 { grid-template-columns: repeat(4, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-4 { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-4 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 400px) {
    .grid--cols-4 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>