---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";

import Screenplay from "../../../../components/screenplay/Screenplay.astro";
import Scene from "../../../../components/screenplay/Scene.astro";
import Action from "../../../../components/screenplay/Action.astro";
import Character from "../../../../components/screenplay/Character.astro";
import Dialogue from "../../../../components/screenplay/Dialogue.astro";
import Parenthetical from "../../../../components/screenplay/Parenthetical.astro";
import Transition from "../../../../components/screenplay/Transition.astro";
import ActBreak from "../../../../components/screenplay/ActBreak.astro";

/**
 * Generate static paths for episodes
 */
export async function getStaticPaths() {
  const episodes = await getCollection("episodes");

  return episodes.map((episode) => {
    const slug = episode.id
      .replace("src/content/episodes/", "")
      .replace(/\.(md|mdx)$/, "");

    return {
      params: { slug },
      props: { episode },
    };
  });
}

const { episode } = Astro.props;

// Extract project from episode data
const project = typeof episode.data.project === 'string' 
  ? episode.data.project 
  : episode.data.project?.id || 'unknown';

// Get project data for title
let projectTitle = project;
try {
  if (project) {
    const projectData = await getEntry(episode.data.project) as any;
    projectTitle = projectData?.data?.title || project;
  }
} catch (error) {
  // Use project slug as fallback
  console.warn(`Could not load project data for ${project}:`, error);
}

// Get all scenes for this episode
const allScenes = await getCollection("scenes", 
  (scene) => {
    const sceneProject = typeof scene.data.project === 'string' 
      ? scene.data.project 
      : scene.data.project?.id;
    return sceneProject === project;
  }
);

// Filter scenes that belong to this episode
const episodeScenes = allScenes.filter(scene => 
  scene.data.episode?.id === episode.id
);

// Sort scenes by scene number
const sortedScenes = episodeScenes.sort((a, b) => a.data.sceneNumber - b.data.sceneNumber);

// Resolve character references for all scenes
const scenesWithCharacters = await Promise.all(
  sortedScenes.map(async (scene) => {
    let characters: any[] = [];
    if (scene.data.characters && scene.data.characters.length > 0) {
      characters = (await Promise.all(
        scene.data.characters.map((charRef) => getEntry(charRef).catch(() => null))
      )).filter(Boolean);
    }

    let location: any[] = [];
    if (scene.data.location && scene.data.location.length > 0) {
      location = (await Promise.all(
        scene.data.location.map((locRef) => getEntry(locRef).catch(() => null))
      )).filter(Boolean);
    }

    const { Content } = await render(scene);
    
    return {
      ...scene,
      Content,
      characters,
      location
    };
  })
);
---

<Layout title={`${episode.data.title} - Episodes`}>
  <div class="container">
    <Breadcrumb 
      items={[
        { label: projectTitle, href: `/projects/${project}` },
        { label: "Episodes", href: `/projects/${project}/episodes` },
        { label: episode.data.title }
      ]} 
    />
    
    <div class="episode-header">
      <h1>{episode.data.title}</h1>
      
      {episode.data.logline && (
        <p class="logline">{episode.data.logline}</p>
      )}
      
      <div class="episode-meta">
        <span class="episode-number">Episode {episode.data.episodeNumber}</span>
        <span class="scene-count">{sortedScenes.length} Scenes</span>
        <span class="status">{episode.data.status}</span>
      </div>
    </div>

    {sortedScenes.length === 0 ? (
      <div class="no-scenes">
        <p>No scenes found for this episode.</p>
      </div>
    ) : (
      <div class="episode-content">
        {scenesWithCharacters.map((scene, index) => (
          <div class="scene-section" id={`scene-${scene.data?.sceneNumber || 'unknown'}`}>
            <div class="scene-header">
              <h2>
                <a href={`/scenes/${scene.id.replace('src/content/scenes/', '').replace(/\.(md|mdx)$/, '')}`}>
                  {scene.data.title}
                </a>
              </h2>
              
              <div class="scene-meta">
                <span class="scene-num">S{scene.data?.sceneNumber || 'Unknown'}</span>
                <span class="int-ext">{scene.data?.intOrExt || 'Unknown'}</span>
                
                {scene.location && scene.location.length > 0 && scene.location.filter(loc => loc && loc.id).length > 0 && (() => {
                  const firstValidLocation = scene.location.find(loc => loc && loc.id);
                  return firstValidLocation ? (
                    <a href={`/locations/${firstValidLocation.id}`} class="location">
                      {scene.location.filter(loc => loc && loc.data).map((loc) => loc.data.name).join(", ")}
                    </a>
                  ) : null;
                })()}
                
                <span class="time">{scene.data?.timeOfDay || 'Unknown'}</span>
                
                {scene.characters && scene.characters.length > 0 && (
                  <details class="characters-dropdown">
                    <summary class="characters-toggle">Characters</summary>
                    <div class="character-list">
                      {scene.characters.filter(char => char && char.id).map((character) => (
                        <a href={`/characters/${character.id}`} class="character-link">
                          {character?.data?.name || 'Unknown Character'}
                        </a>
                      ))}
                    </div>
                  </details>
                )}
              </div>
            </div>

            <div class="scene-content markdown">
              <div class="screenplay-root">
                <scene.Content
                  components={{
                    Screenplay,
                    Scene,
                    Action,
                    Character,
                    Dialogue,
                    Parenthetical,
                    Transition,
                    ActBreak,
                  }}
                />
              </div>
            </div>
            
            {index < scenesWithCharacters.length - 1 && (
              <div class="scene-divider"></div>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .episode-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 3px solid #eee;
  }

  .episode-header h1 {
    margin: 0 0 1rem 0;
    font-size: 2.5rem;
  }

  .logline {
    font-size: 1.125rem;
    color: var(--text-secondary);
    font-style: italic;
    margin: 0 0 1.5rem 0;
    line-height: 1.6;
  }

  .episode-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .episode-number,
  .scene-count,
  .status {
    background: #f0f0f0;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: bold;
  }

  .episode-number {
    background: #bbddf3;
    color: #1a5a8a;
  }

  .scene-count {
    background: #e8f5e8;
    color: #2e7d32;
  }

  .status {
    background: #fff3e0;
    color: #e65100;
    text-transform: capitalize;
  }

  .no-scenes {
    text-align: center;
    padding: 3rem;
    color: var(--text-secondary);
  }

  .episode-content {
    margin-top: 2rem;
  }

  .scene-section {
    margin-bottom: 4rem;
  }

  .scene-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #eee;
  }

  .scene-header h2 {
    margin: 0 0 1rem 0;
  }

  .scene-header h2 a {
    text-decoration: none;
    color: inherit;
  }

  .scene-header h2 a:hover {
    text-decoration: underline;
    color: var(--accent);
  }

  .scene-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .scene-num,
  .int-ext,
  .location,
  .time,
  .characters-toggle,
  .character-link {
    background: #f0f0f0;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: bold;
  }

  .scene-num {
    background: #e8f5e8;
    color: #2e7d32;
  }

  .int-ext {
    background: #fff3e0;
    color: #e65100;
  }

  .location {
    background: #e3f2fd;
    color: #1976d2;
    text-decoration: none;
  }

  .location:hover {
    background: #bbddf3;
    text-decoration: underline;
  }

  .time {
    background: #f3e5f5;
    color: #7b1fa2;
  }

  /* Characters toggle */
  .characters-dropdown {
    position: static;
  }

  .characters-toggle {
    list-style: none;
    cursor: pointer;
    color: #444;
  }

  .characters-toggle::-webkit-details-marker {
    display: none;
  }

  .characters-dropdown[open] .characters-toggle {
    background: #e0e0e0;
  }

  .character-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #eee;
  }

  .characters-dropdown[open] {
    flex-basis: 100%;
  }

  .characters-dropdown {
    display: contents;
  }

  .character-link {
    color: #444;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
  }

  .character-link:hover {
    background: #e0e0e0;
  }

  .scene-content {
    line-height: 1.6;
  }

  .scene-divider {
    height: 2px;
    background: linear-gradient(to right, transparent, #ddd, transparent);
    margin: 3rem 0;
  }

  @media (max-width: 768px) {
    .container {
      padding: 1rem;
    }

    .episode-header h1 {
      font-size: 2rem;
    }

    .episode-meta {
      gap: 0.5rem;
    }

    .scene-meta {
      gap: 0.25rem;
    }

    .scene-num,
    .int-ext,
    .location,
    .time,
    .characters-toggle,
    .character-link {
      padding: 0.375rem 0.75rem;
      font-size: 0.75rem;
    }
  }
</style>
