---
/**
 * /projects/[...slug]/characters.astro
 *
 * Project-specific characters index page.
 * Shows only characters belonging to the current project.
 */

import { getCollection, getEntry } from "astro:content";
import { type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CharacterCard from "../../../components/collection-cards/CharacterCard.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import TopFive from "../../../components/projects/screenplays/stats/TopFive.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

// Get characters for this project only
const characters = await getCollection("characters", (character) => character.data.project.id === project.id);

// Sort alphabetically by name
const sorted = characters.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout title={`${project.data.title} - Characters`}>
  <div class="project-collection">
    <header class="collection-header">
      <Breadcrumb 
        items={[
          { label: "Projects", href: "/projects" },
          { label: project.data.title, href: `/projects/${project.id}` },
          { label: "Characters" }
        ]} 
      />
      
      <h1>Characters</h1>
      <p class="collection-description">
        {sorted.length} character{sorted.length !== 1 ? 's' : ''} from <em>{project.data.title}</em>
      </p>

      <div class="top5-grid" id="topFives">
        <TopFive project="her-majestys-displeasure" type="characters-by-lines" />
        <TopFive project="her-majestys-displeasure" type="character-pairs" />
      </div>
    </header>


    {sorted.length === 0 ? (
      <p class="empty">No characters yet for this project.</p>
    ) : (
      <ul class="grid grid--cols-3">
        {sorted.map((entry) => (
          <li>
            <CharacterCard entry={entry} />
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<script is:inline>
  //1. Grab all the details elements inside your specific grid:
  const group = document.getElementById('topFives');
  const detailsElements = group.querySelectorAll('details');

  // 2. Listen for the 'toggle' event on each one
  detailsElements.forEach(details => {
    details.addEventListener('toggle', (event) => {
      const isOpen = event.target.open;

      // 3. Loop through all of them and match the state
      detailsElements.forEach(otherDetails => {
        // The check prevents an infinite loop of toggle events
        if (otherDetails !== event.target && otherDetails.open !== isOpen) {
          otherDetails.open = isOpen;
        }
      });
    });
  });

</script>

<style>

  .top5-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    margin-top: var(--space-8);
  }
  .project-collection {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-8);
  }

  .collection-header {
    margin-bottom: var(--space-8);
  }

  .collection-header h1 {
    font-size: var(--text-3xl);
    font-weight: 600;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }

  .collection-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    margin: 0;
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-3 { grid-template-columns: repeat(3, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .project-collection {
      padding: var(--space-6);
    }
    
    .grid--cols-3 { grid-template-columns: 1fr; }
    
    .collection-header h1 {
      font-size: var(--text-2xl);
    }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>
