---
/**
 * /projects/index.astro
 *
 * Index page for all projects (screenplays, standalone films, books).
 * Clicking a project card navigates to the project detail page,
 * which has its own sub-navigation for episodes, scenes, characters, etc.
 */

import { getCollection, type CollectionEntry } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import ProjectCard from "../../components/collection-cards/ProjectCard.astro";
import NewProjectButton from "../../components/editor/NewProjectButton.astro";

const projects = await getCollection("projects");

// Sort alphabetically by title
const sorted = projects.sort((a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
  a.data.title.localeCompare(b.data.title)
);
---

<IndexLayout
  title="Projects"
  count={sorted.length}
  description="Screenplays, films, and books."
>
  <div slot="actions">
    <NewProjectButton />
  </div>
  {sorted.length === 0 ? (
    <p class="empty">No projects yet.</p>
  ) : (
    <ul class="grid grid--cols-3">
      {sorted.map((entry: CollectionEntry<"projects">) => (
        <li>
          <ProjectCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-3 { grid-template-columns: repeat(3, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-3 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>