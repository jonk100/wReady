---
/**
 * /reviews/index.astro
 *
 * Index page for all reviews. Uses the image card variant when a
 * poster is available (which it will be after enrich-tmdb.ts runs).
 */

import fs from 'node:fs/promises';
import path from 'node:path';
import matter from 'gray-matter';
import IndexLayout from "../../layouts/IndexLayout.astro";
import ReviewCard from "../../components/collection-cards/ReviewCard.astro";
// import ReviewCreateForm from "../../components/reviews/ReviewCreateForm.astro";
import ReviewCreateForm from "../../components/forms/reviews/ReviewCreateForm.astro";

export const prerender = false;

/**
 * Reads all reviews .mdx files directly from disk at request time.
 * Bypasses Astro's content store, which is stale between SSR requests.
 * Shaped like CollectionEntry so downstream components need no changes.
 */
const collectionDir = path.resolve(process.cwd(), 'src/content/reviews');
const files = await fs.readdir(collectionDir);

const reviews = (
  await Promise.all(
    files
      .filter(f => f.endsWith('.md') || f.endsWith('.mdx'))
      .map(async (file) => {
        const raw = await fs.readFile(path.join(collectionDir, file), 'utf-8');
        const { data } = matter(raw);
        const id = file.replace(/\.(md|mdx)$/, '');
        return { 
          id, 
          data: data as any,
          collection: "reviews" as const 
        };
      })
  )
).sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<IndexLayout
  title="Reviews"
  count={reviews.length}
  description="Film, TV, and other media."
>
  <ReviewCreateForm />
  
  {reviews.length === 0 ? (
    <p class="empty">No reviews yet.</p>
  ) : (
    <ul class="grid grid--cols-2">
      {reviews.map((entry) => (
        <li>
          <ReviewCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-2 { grid-template-columns: repeat(2, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-2 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-2 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>