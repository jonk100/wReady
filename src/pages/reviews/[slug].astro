---
import { getCollection, render, type CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const reviews = await getCollection("reviews");
  return reviews.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

interface Props {
  entry: CollectionEntry<"reviews">;
}

const { entry } = Astro.props;
const { data } = entry;

// Use the new Content Layer render function
const { Content } = await render(entry);

/**
 * Formats a Date object into a human-readable string.
 * @param {Date} date - The date to format.
 * @returns {string} e.g. "March 17, 2024"
 */
function formatDate(date: Date): string {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
}

/**
 * Derives a display name from an actor's slug or reference object.
 * e.g. "michael-dorman" → "Michael Dorman"
 * @param {string | { id: string }} slugOrRef - The actor's content collection ID or reference object.
 * @returns {string} Title-cased display name.
 */
function formatActorName(slugOrRef: string | { id: string }): string {
  const slug = typeof slugOrRef === 'string' ? slugOrRef : slugOrRef.id;
  return slug
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}

const topActors = data.cast?.slice(0, 3) ?? [];
---

<BaseLayout
  title={data.title}
  description={data.subtitle || `Review of ${data.title}`}
>
  <article class="review-detail">
    <header class="review-header">
      <div class="review-meta">
        <div class="review-meta-row">
          <span class="category">{data.category}</span>
          {data.year && <span class="year">{data.year}</span>}
          {data.status && (
            <span class={`status status--${data.status}`}>{data.status}</span>
          )}
        </div>

        <div class="review-meta-row">
          {data.pubDate && (
            <time class="pub-date" datetime={data.pubDate.toISOString()}>
              {formatDate(data.pubDate)}
            </time>
          )}
          {data.channel && <span class="channel">{data.channel}</span>}
          {data.episodes && <span class="episodes">{data.episodes} episodes</span>}
        </div>
      </div>

      <h1 class="review-title">{data.title}</h1>

      {data.subtitle && (
        <p class="review-subtitle">{data.subtitle}</p>
      )}

      <div class="review-ratings">
        {data.finalScore && (
          <div class="rating">
            <span class="rating-label">Score</span>
            <span class="rating-value">{data.finalScore}/10</span>
          </div>
        )}
        {data.tmdbRating && (
          <div class="rating">
            <span class="rating-label">TMDB</span>
            <span class="rating-value">{data.tmdbRating.toFixed(1)}/10</span>
          </div>
        )}
        {data.imdbRating && (
          <div class="rating">
            <span class="rating-label">IMDb</span>
            <span class="rating-value">{data.imdbRating}/10</span>
          </div>
        )}
        {data.rottenTomatoesRating && (
          <div class="rating">
            <span class="rating-label">Rotten Tomatoes</span>
            <span class="rating-value">{data.rottenTomatoesRating}%</span>
          </div>
        )}
      </div>
    </header>

    {(data.poster || data.heroImage) && (
      <div class="review-poster">
        <img
          src={(data.poster || data.heroImage) as string}
          alt={`${data.title} poster`}
          loading="lazy"
        />
      </div>
    )}

    {data.overview && (
      <section class="overview-section">
        <h2>Overview</h2>
        <p class="overview">{data.overview}</p>
      </section>
    )}

    {data.cast && data.cast.length > 0 && (
      <section class="cast-section">
        <h2>Cast</h2>
        <div class="cast-grid">
          {data.cast.map((actorRef: any, index: number) => {
            // Handle both string slugs and reference objects
            const actorSlug = typeof actorRef === 'string' ? actorRef : actorRef.id;
            // Try to get character info from castDetailed if available
            const castDetail = data.castDetailed?.[index];
            return (
              <a href={`/actors/${actorSlug}`} class="cast-card">
                <div class="cast-info">
                  <h3>{formatActorName(actorSlug)}</h3>
                  {castDetail?.character && <p class="character">{castDetail.character}</p>}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {(data.writers || data.directors || data.productionCompanies) && (
      <section class="credits-section">
        <h2>Credits</h2>
        <div class="credits-grid">
          {data.writers && data.writers.length > 0 && (
            <div class="credit-item">
              <span class="credit-label">Writers</span>
              <span class="credit-value">{data.writers.join(', ')}</span>
            </div>
          )}
          {data.directors && data.directors.length > 0 && (
            <div class="credit-item">
              <span class="credit-label">Directors</span>
              <span class="credit-value">{data.directors.join(', ')}</span>
            </div>
          )}
          {data.productionCompanies && data.productionCompanies.length > 0 && (
            <div class="credit-item">
              <span class="credit-label">Production</span>
              <span class="credit-value">{data.productionCompanies.join(', ')}</span>
            </div>
          )}
        </div>
      </section>
    )}

    {(data.season || data.episode || data.episodes) && (
      <section class="tv-section">
        <h2>Season & Episode Info</h2>
        <div class="tv-info">
          {data.season && <span>Season {data.season}</span>}
          {data.episode && <span>Episode {data.episode}</span>}
          {data.episodes && <span>{data.episodes} episodes total</span>}
        </div>
      </section>
    )}

    {data.tags && data.tags.length > 0 && (
      <section class="tags-section">
        <h2>Tags</h2>
        <div class="tags">
          {data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </section>
    )}

    {data.themes && data.themes.length > 0 && (
      <section class="themes-section">
        <h2>Themes</h2>
        <div class="tags">
          {data.themes.map((theme: { id: string }) => (
            <span class="tag theme-tag">{formatActorName(theme.id)}</span>
          ))}
        </div>
      </section>
    )}

    <div class="review-content">
      <div class="content-body">
        <Content />
      </div>
    </div>

    <style is:global>
      .content-body h1,
      .content-body h2,
      .content-body h3,
      .content-body h4,
      .content-body h5,
      .content-body h6 {
        margin: 2rem 0 0.25rem 0 !important;
      }

      .content-body h2 {
        font-size: 1.5rem;
      }

      .content-body h3 {
        font-size: 1.25rem;
      }

      .content-body p {
        margin: 0 0 2rem 0 !important;
      }
    </style>

    {(data.imdbId || data.url) && (
      <footer class="review-footer">
        <a href={data.imdbId ? `https://www.imdb.com/title/${data.imdbId}/` : data.url} class="external-link" target="_blank" rel="noopener noreferrer">
          View on IMDb
        </a>
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .review-detail {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-8) 0;
  }

  .review-header {
    margin-bottom: var(--space-8);
  }

  .review-meta {
    margin-bottom: var(--space-4);
  }

  .review-meta-row {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .category {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .year,
  .channel,
  .episodes,
  .pub-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .status {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
  }

  .status--published {
    background: var(--status-published);
    color: white;
  }

  .status--draft {
    background: var(--status-draft);
    color: white;
  }

  .review-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 var(--space-4) 0;
    color: var(--text-primary);
  }

  .review-subtitle {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    margin: 0 0 var(--space-6) 0;
    line-height: 1.4;
  }

  .review-ratings {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .rating {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .rating-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .rating-value {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
  }

  .review-poster {
    margin-bottom: var(--space-8);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .review-poster img {
    width: 100%;
    height: auto;
    display: block;
  }

  .review-content {
    margin-bottom: var(--space-8);
  }

  .content-body {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /*
   * The MDX body often opens with a redundant h1 matching data.title,
   * which is already rendered in the <header>. Hide it so it doesn't
   * appear twice on the page.
   */
  .content-body > h1:first-child {
    display: none;
  }

  .cast-section {
    margin-bottom: var(--space-8);
  }

  .cast-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .cast-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .cast-card {
    display: block;
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-fast);
  }

  .cast-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .cast-info h3 {
    font-size: var(--text-base);
    margin: 0;
    color: var(--text-primary);
  }

  .cast-info .character {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: var(--space-1) 0 0 0;
  }

  .overview-section {
    margin-bottom: var(--space-8);
  }

  .overview-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .overview {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .credits-section {
    margin-bottom: var(--space-8);
  }

  .credits-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .credits-grid {
    display: grid;
    gap: var(--space-3);
  }

  .credit-item {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
  }

  .credit-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    min-width: 100px;
  }

  .credit-value {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .tv-section {
    margin-bottom: var(--space-8);
  }

  .tv-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .tv-info {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .tv-info span {
    padding: 0.3em 0.8em;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
  }

  .themes-section {
    margin-bottom: var(--space-8);
  }

  .themes-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .theme-tag {
    background: var(--accent);
    color: white;
  }

  .tags-section {
    margin-bottom: var(--space-8);
  }

  .tags-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    font-size: var(--text-sm);
    padding: 0.3em 0.8em;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
  }

  .review-footer {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .external-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .external-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .review-detail {
      padding: var(--space-6) 0;
    }

    .review-title {
      font-size: var(--text-3xl);
    }

    .review-subtitle {
      font-size: var(--text-lg);
    }

    .cast-grid {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }
  }
</style>