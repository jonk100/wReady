---
/**
 * /beats/index.astro
 *
 * Index page for all beats across all projects.
 * Uses BeatCard components for consistent styling with other collection pages.
 */

import { getCollection, type CollectionEntry } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import BeatCard from "../../components/collection-cards/BeatCard.astro";

const beats = await getCollection("beats");

// Sort by project, then by plot (first plot if multiple), then by beat number
const sorted = beats.sort((a, b) => {
  const projectCompare = a.data.project.id.localeCompare(b.data.project.id);
  if (projectCompare !== 0) return projectCompare;
  
  const aPlotId = a.data.plots && a.data.plots.length > 0 ? a.data.plots[0].plot.id : '';
  const bPlotId = b.data.plots && b.data.plots.length > 0 ? b.data.plots[0].plot.id : '';
  const plotCompare = aPlotId.localeCompare(bPlotId);
  if (plotCompare !== 0) return plotCompare;
  
  const aBeatNumber = a.data.plots && a.data.plots.length > 0 ? (a.data.plots[0].beatNumber || 0) : 0;
  const bBeatNumber = b.data.plots && b.data.plots.length > 0 ? (b.data.plots[0].beatNumber || 0) : 0;
  return aBeatNumber - bBeatNumber;
});
---

<IndexLayout
  title="Beats"
  count={sorted.length}
  description="All beats from all projects."
>
  {sorted.length === 0 ? (
    <p class="empty">No beats yet.</p>
  ) : (
    <ul class="grid grid--cols-4">
      {sorted.map((entry) => (
        <li>
          <BeatCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-4 { grid-template-columns: repeat(4, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-4 { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-4 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 400px) {
    .grid--cols-4 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>
