---
/**
 * /songs/index.astro
 *
 * Index page for all songs. Standalone songs and album tracks shown together.
 * Uses SongCard components for consistent styling with other collection pages.
 */

import fs from 'node:fs/promises';
import path from 'node:path';
import matter from 'gray-matter';
import type { CollectionEntry } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import SongCard from "../../components/collection-cards/SongCard.astro";
// import SongCreateForm from "../../components/songs/new-song/SongCreateForm.astro";
import SongCreateForm from "../../components/forms/songs/SongCreateForm.astro";

export const prerender = false;

type SongEntry = CollectionEntry<"songs">;

/**
 * Reads all song .mdx files directly from disk at request time,
 * bypassing Astro's content store (which is populated at build time
 * and does not update between SSR requests).
 *
 * Returns an array shaped like CollectionEntry<"songs"> so SongCard
 * components remain unchanged.
 *
 * @returns {Promise<Array<{ id: string, data: Record<string, any> }>>}
 */
const songsDir = path.resolve(process.cwd(), 'src/content/songs');

const files = await fs.readdir(songsDir);

const songs = (
  await Promise.all(
    files
      .filter(f => f.endsWith('.md') || f.endsWith('.mdx'))
      .map(async (file) => {
        const raw = await fs.readFile(path.join(songsDir, file), 'utf-8');
        const { data } = matter(raw);
        const id = file.replace(/\.(md|mdx)$/, '');
        return { 
          id, 
          data: data as SongEntry['data'], 
          collection: "songs" as const 
        };
      })
  )
).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<IndexLayout
  title="Songs"
  count={songs.length}
  description="All songs — standalone and album tracks."
>
  <SongCreateForm />
  
  {songs.length === 0 ? (
    <p class="empty">No songs yet.</p>
  ) : (
    <ul class="grid grid--cols-3">
      {songs.map((entry) => (
        <li>
          <SongCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-3 { grid-template-columns: repeat(3, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-3 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }

  /* Song-specific CSS variables */
  :root {
    --key-major: #3b82f6;
    --key-minor: #ef4444;
  }
</style>