---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChordVoicingsSection from "../../components/songs/ChordVoicingsSection.astro";
import SongStructureSection from "../../components/songs/SongStructureSection.astro";
import SongSectionDetails from "../../components/songs/SongSectionDetails.astro";
import LyricsSection from "../../components/songs/LyricsSection.astro";
import { parseLyrics } from "../../utils/parseLyrics";
import type { ParsedBlock } from "../../utils/parseLyrics";

export const getStaticPaths: GetStaticPaths = async () => {
  const songs = await getCollection("songs");
  return songs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

interface Props {
  entry: any;
}

const { entry } = Astro.props as Props;
const { data, body } = entry;

const allChords = await getCollection("chords");
const chordMap = new Map(allChords.map((chord) => [chord.id, chord]));

/**
 * Builds a lookup map from section name → section definition,
 * using the frontmatter sections array as the single source of truth.
 */
const sectionMap = new Map((data.sections ?? []).map((s: any) => [s.name, s]));

/**
 * Parses the raw body into blocks. Each SectionOccurrence is enriched
 * with its matching section definition from the frontmatter sectionMap.
 */
const parsedBlocks: ParsedBlock[] = parseLyrics(body ?? "");

/**
 * True if the body contains any [section] markers.
 * Determines whether to render structured lyrics or plain prose fallback.
 */
const hasStructuredLyrics = parsedBlocks.some((b) => !("kind" in b));

/** @returns "Dm" for minor, "D" for major */
function formatKey(keyRoot: string, keyMode: string): string {
  return `${keyRoot}${keyMode === "minor" ? "m" : ""}`;
}

function formatTimeSignature(top: number, bottom: number): string {
  return `${top}/${bottom}`;
}

function getKeyColor(keyMode: string): string {
  return keyMode === "minor" ? "var(--key-minor)" : "var(--key-major)";
}

/**
 * Calculates total bars across the full song structure, accounting for repeats.
 *
 * @param sections  - The data.sections array from frontmatter
 * @param structure - The data.structure array (ordered section names)
 */
function calculateTotalBars(sections: any[], structure: string[]): number {
  const map = new Map(sections.map((s: any) => [s.name, s]));
  return structure.reduce((total: number, name: string) => {
    const s = map.get(name);
    return total + (s ? s.bars * (s.repeats ?? 1) : 0);
  }, 0);
}

const totalBars = calculateTotalBars(data.sections ?? [], data.structure ?? []);
---

<BaseLayout
  title={data.title}
  description={`Song details for ${data.title} in ${formatKey(data.keyRoot, data.keyMode)}`}
>
  <article class="song-detail">
    <header class="song-header">
      <div class="song-info">
        <h1 class="song-title">{data.title}</h1>
        
        <div class="song-meta">
          <div class="meta-item">
            <span class="meta-label">Key</span>
            <span 
              class="meta-value key-badge"
              style={`background-color: ${getKeyColor(data.keyMode)}`}
            >
              {formatKey(data.keyRoot, data.keyMode)}
            </span>
          </div>
          
          <div class="meta-item">
            <span class="meta-label">Time Signature</span>
            <span class="meta-value">{formatTimeSignature(data.timeSignatureTop, data.timeSignatureBottom)}</span>
          </div>
          
          {data.tempo && (
            <div class="meta-item">
              <span class="meta-label">Tempo</span>
              <span class="meta-value">{data.tempo} BPM</span>
            </div>
          )}
          
          <div class="meta-item">
            <span class="meta-label">Total bars</span>
            <span class="meta-value">{totalBars}</span>
          </div>
          
          {data.album && 'data' in data.album && data.album.data?.title && (
            <div class="meta-item">
              <span class="meta-label">Album</span>
              <span class="meta-value">{data.album.data.title}</span>
            </div>
          )}
        </div>
      </div>
    </header>

    <SongStructureSection 
      structure={data.structure}
      sections={data.sections}
    />

    <ChordVoicingsSection 
      chordVoicings={data.chordVoicings}
      chordMap={chordMap}
    />


    <SongSectionDetails sections={data.sections} />

    <!-- ── Lyrics ──────────────────────────────────────────────────────────── -->
    <section class="song-lyrics">
      {hasStructuredLyrics
        ? parsedBlocks.map((block: ParsedBlock) => {
            if ("kind" in block) {
              return block.lyrics ? <p class="song-preamble">{block.lyrics}</p> : null;
            }

            const section = sectionMap.get(block.sectionName) as any;
            if (!section) return null;

            return (
              <LyricsSection
                name={block.sectionName}
                documentIndex={block.documentIndex}
                section={section}
                slices={block.slices}
              />
            );
          })
        : (body ?? "").split("\n\n").map((para: string) => (
            <p class="plain-body-para">{para.trim()}</p>
          ))}
    </section>
  </article>
</BaseLayout>

<style>
  .song-detail {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-8) 0;
  }

  .song-header {
    margin-bottom: var(--space-8);
  }

  .song-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 var(--space-6) 0;
    color: var(--text-primary);
  }

  .song-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .meta-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .meta-value {
    font-size: var(--text-base);
    color: var(--text-secondary);
    font-weight: 500;
  }

  .key-badge {
    color: white;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-weight: 700;
    display: inline-block;
  }

  .song-lyrics {
    margin-top: var(--space-8);
  }

  .song-preamble {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
    white-space: pre-wrap;
  }

  .plain-body-para {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    white-space: pre-wrap;
  }

  :root {
    --key-major: #3b82f6;
    --key-minor: #ef4444;
  }

  .chord-voicings h2,
  .song-content h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin: 0 0 var(--space-4) 0;
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .song-detail  { padding: var(--space-6) 0; }
    .song-title   { font-size: var(--text-3xl); }
    .song-meta    { grid-template-columns: 1fr; }
  }
</style>
