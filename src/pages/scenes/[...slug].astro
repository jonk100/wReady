---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";

import Screenplay from "../../components/screenplay/Screenplay.astro";
import Scene from "../../components/screenplay/Scene.astro";
import Action from "../../components/screenplay/Action.astro";
import Character from "../../components/screenplay/Character.astro";
import Dialogue from "../../components/screenplay/Dialogue.astro";
import Parenthetical from "../../components/screenplay/Parenthetical.astro";
import Transition from "../../components/screenplay/Transition.astro";
import ActBreak from "../../components/screenplay/ActBreak.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PreviousNextScene from "../../components/scenes/PreviousNextScene.astro";
import MetadataHeader from "../../components/scenes/MetadataHeader.astro";

import { readFileSync } from "node:fs";
import { join } from "node:path";
import '@/styles/pages/scenes/slug.css';

/**
 * Generate static paths for scenes
 */
export async function getStaticPaths() {
  const scenes = await getCollection("scenes");

  return scenes.map((scene: CollectionEntry<"scenes">) => {
    const slug = scene.id
      .replace("src/content/scenes/", "")
      .replace(/\.(md|mdx)$/, "");

    return {
      params: { slug },
      props: { scene },
    };
  });
}

const { scene } = Astro.props;
const { Content } = await render(scene);

// Get raw markdown content for editor
const scenePath = join(process.cwd(), "src/content/scenes", `${scene.id}.mdx`);
let rawContent = "";
try {
  rawContent = readFileSync(scenePath, "utf-8");
} catch (error) {
  console.error("Could not read scene file:", error);
}

// Get all scenes for navigation
const allScenes = await getCollection("scenes");
const projectScenes = allScenes
  .filter((s: CollectionEntry<"scenes">) => s.data.project.id === scene.data.project.id)
  .sort((a: CollectionEntry<"scenes">, b: CollectionEntry<"scenes">) => a.data.sceneNumber - b.data.sceneNumber);

const currentIndex = projectScenes.findIndex((s: CollectionEntry<"scenes">) => s.id === scene.id);
const prevScene = currentIndex > 0 ? projectScenes[currentIndex - 1] : null;
const nextScene = currentIndex < projectScenes.length - 1 ? projectScenes[currentIndex + 1] : null;

// Extract project from scene data
const project = scene.data.project.id || 'unknown';

// Get project data for title
let projectTitle = project;
try {
  if (project) {
    const projectData = await getEntry(scene.data.project) as any;
    projectTitle = projectData?.data?.title || project;
  }
} catch (error) {
  // Use project slug as fallback
  console.warn(`Could not load project data for ${project}:`, error);
}

/**
 * Resolve character references (filter out missing entries)
 */
