---
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main class="home">
		<section class="hero">
			<h1>wReady</h1>
			<p class="tagline">A personal creative writing and music workbench.</p>
			<p class="description">
				Screenplays, songs, poems, and stories &mdash; structured as MDX content collections,
				rendered with a custom screenplay parser, and managed through an interactive web interface.
			</p>
		</section>

		<section class="nav-grid">
			<a href="/projects" class="nav-card">
				<strong>Projects</strong>
				<span>Screenplay series and creative projects</span>
			</a>
			<a href="/songs" class="nav-card">
				<strong>Songs</strong>
				<span>Chord sheets, structures, and voicings</span>
			</a>
			<a href="/chords" class="nav-card">
				<strong>Chords</strong>
				<span>Guitar chord library and analyser</span>
			</a>
			<a href="/writings" class="nav-card">
				<strong>Writings</strong>
				<span>Poems, short stories, and albums</span>
			</a>
			<a href="/posts" class="nav-card">
				<strong>Posts</strong>
				<span>Blog series and articles</span>
			</a>
			<a href="/reviews" class="nav-card">
				<strong>Reviews</strong>
				<span>Film and TV write-ups</span>
			</a>
		</section>
	</main>
	<Footer />
</BaseLayout>

<style>
	.home {
		max-width: 48rem;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}

	.hero {
		margin-bottom: 3rem;
	}

	.hero h1 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}

	.tagline {
		font-size: 1.25rem;
		opacity: 0.7;
		margin-bottom: 1rem;
	}

	.description {
		max-width: 36rem;
		line-height: 1.6;
	}

	.nav-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
		gap: 1rem;
	}

	.nav-card {
		display: block;
		padding: 1.25rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 0.5rem;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.2s;
	}

	.nav-card:hover {
		border-color: rgba(255, 255, 255, 0.3);
	}

	.nav-card strong {
		display: block;
		margin-bottom: 0.25rem;
	}

	.nav-card span {
		font-size: 0.875rem;
		opacity: 0.6;
	}
</style>
