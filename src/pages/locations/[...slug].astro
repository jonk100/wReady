---
import { getEntry, getCollection, render } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import Breadcrumb from "../../components/Breadcrumb.astro";

/**
 * Generate static paths for location pages
 */
export async function getStaticPaths() {
  const locations = await getCollection("locations");

  return locations.map((location) => {
    const slug = location.id
      .replace("src/content/locations/", "")
      .replace(/\.(md|mdx)$/, "");

    return {
      params: { slug },
      props: { location },
    };
  });
}

const { location } = Astro.props;
const { Content, headings } = await render(location);

// Extract project from location data
const project = location.data.project.id || 'unknown';

// Get project data for title
let projectTitle = project;
try {
  if (project) {
    const projectData = await getEntry(location.data.project) as any;
    projectTitle = projectData?.data?.title || project;
  }
} catch (error) {
  // Use project slug as fallback
  console.warn(`Could not load project data for ${project}:`, error);
}

// Get related scenes that use this location
const scenes = await getCollection("scenes");
const relatedScenes = scenes.filter(scene => 
  scene.data.location && 
  scene.data.location.some(locRef => locRef.id === location.id)
);

// Sort scenes by number
const sortedScenes = relatedScenes.sort((a, b) => {
  const aNum = parseInt(String(a.data.sceneNumber)) || 0;
  const bNum = parseInt(String(b.data.sceneNumber)) || 0;
  return aNum - bNum;
});
---

<Layout title={`${location.data.name} - Locations`}>
  <div class="container">
    <Breadcrumb 
      items={[
        { label: projectTitle, href: `/projects/${project}` },
        { label: "Locations", href: `/projects/${project}/locations` },
        { label: location.data.name }
      ]} 
    />
    
    <div class="location-header">
      <h1>{location.data.name}</h1>
      
      <div class="location-meta">
        {location.data.intOrExt && (
          <span class="int-ext">{location.data.intOrExt}</span>
        )}
        
        {location.data.type && (
          <span class="type">{location.data.type}</span>
        )}
        
        {location.data.realWorldRef && (
          <span class="real-world">{location.data.realWorldRef}</span>
        )}
      </div>
      
      {location.data.description && (
        <p class="description">{location.data.description}</p>
      )}
      
      {location.data.mood && (
        <p class="mood"><strong>Mood:</strong> {location.data.mood}</p>
      )}
    </div>

    <div class="location-content">
      <div class="main-content">
        <div class="markdown">
          <Content />
        </div>
      </div>

      <aside class="sidebar">
        {sortedScenes.length > 0 && (
          <div class="info-card">
            <h3>Scenes</h3>
            <ul class="scene-list">
              {sortedScenes.map((scene) => (
                <li>
                  <a href={`/scenes/${scene.id.replace('src/content/scenes/', '').replace(/\.(md|mdx)$/, '')}`}>
                    Scene {scene.data.sceneNumber}: {scene.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        
        {location.data.visual_notes && (
          <div class="info-card">
            <h3>Visual Notes</h3>
            <p>{location.data.visual_notes}</p>
          </div>
        )}
        
        {location.data.practical_notes && (
          <div class="info-card">
            <h3>Practical Notes</h3>
            <p>{location.data.practical_notes}</p>
          </div>
        )}
        
        {location.data.scenes_used && location.data.scenes_used.length > 0 && (
          <div class="info-card">
            <h3>Used In Scenes</h3>
            <ul>
              {location.data.scenes_used.map((sceneRef) => (
                <li>{sceneRef}</li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem;
  }

  .location-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border);
  }

  .location-header h1 {
    margin: 0 0 1rem 0;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .location-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    
  }

  .int-ext,
  .type,
  .real-world {
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .int-ext {
    background: var(--bg-raised);
    color: #e65100;
  }

  .type {
    background: var(--text-muted);
    border: 1px solid var(--border-strong);
    color: var(--text-primary);
  }

  .real-world {
    background: var(text-muted);
    color: #7b1fa2;
  }

  .description {
    font-size: 1.125rem;
    line-height: 1.6;
    color:var(--text-secondary);
    font-style: italic;
    margin: 0 0 1rem 0;
  }

  .mood {
    margin: 0;
    font-size: 1rem;
    color: var(--accent-dim);
  }

  .location-content {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
  }

  .main-content {
    min-width: 0;
  }

  .markdown {
    line-height: 1.7;
  }

  .markdown h1,
  .markdown h2,
  .markdown h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .markdown h1 {
    font-size: 2rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .markdown h2 {
    font-size: 1.5rem;
  }

  .markdown h3 {
    font-size: 1.25rem;
  }

  .markdown p {
    margin-bottom: 1rem;
  }

  .markdown ul,
  .markdown ol {
    margin-bottom: 1rem;
    padding-left: 2rem;
  }

  .markdown li {
    margin-bottom: 0.5rem;
  }

  .sidebar {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .info-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .info-card h3 {
    margin: 0 0 1rem 0;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
  }

  .info-card p {
    margin: 0;
    font-size: 0.875rem;
  }

  .info-card ul {
    margin: 0;
    padding-left: 1.5rem;
    font-size: 0.875rem;
  }

  .scene-list {
    list-style: none;
    padding: 0;
  }

  .scene-list li {
    margin-bottom: 0.5rem;
  }

  .scene-list a {
    display: block;
    padding: 0.5rem;
    background: var(--bg-raised);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .scene-list a:hover {
    background: var(--bg-raised-hover);
    border-color: var(--border);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .location-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sidebar {
      position: static;
      order: -1;
    }

    .info-card {
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 1rem;
    }

    .location-header h1 {
      font-size: 2rem;
    }

    .location-meta {
      flex-direction: column;
      gap: 0.5rem;
    }

    .location-content {
      gap: 1.5rem;
    }
  }
</style>
