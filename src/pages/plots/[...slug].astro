---
import { getEntry, getCollection, render } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import Breadcrumb from "../../components/Breadcrumb.astro";
import TensionGraph from "../../components/TensionGraph.astro";
import PlotBeatCard from "../../components/collection-cards/PlotBeatCard.astro";
import { extractTensionData } from "../../utils/tension";

/**
 * Generate static paths for plot pages
 */
export async function getStaticPaths() {
  const plots = await getCollection("plots");

  return plots.map((plot) => {
    const slug = plot.id
      .replace("src/content/plots/", "")
      .replace(/\.(md|mdx)$/, "");

    return {
      params: { slug },
      props: { plot },
    };
  });
}

const { plot } = Astro.props;
const { Content, headings } = await render(plot);

// Extract project from plot data
const project = plot.data.project.id || 'unknown';

// Get project data for title
let projectTitle = project;
try {
  if (project) {
    const projectData = await getEntry(plot.data.project) as any;
    projectTitle = projectData?.data?.title || project;
  }
} catch (error) {
  // Use project slug as fallback
  console.warn(`Could not load project data for ${project}:`, error);
}

// Get related scenes this plot appears in
const scenes = await getCollection("scenes");
const relatedScenes = scenes.filter(scene => 
  scene.data.plots && 
  scene.data.plots.some(plotRef => plotRef.id === plot.id)
);

// Sort scenes by episode and scene number
const sortedScenes = await Promise.all(relatedScenes.map(async (scene) => {
  let episodeNumber = 0;
  if (scene.data.episode) {
    const episode = await getEntry(scene.data.episode);
    episodeNumber = episode?.data?.episodeNumber || 0;
  }
  
  return {
    ...scene,
    episodeNumber,
    sceneNumber: parseInt(String(scene.data.sceneNumber)) || 0
  };
}));

sortedScenes.sort((a, b) => {
  if (a.episodeNumber !== b.episodeNumber) return a.episodeNumber - b.episodeNumber;
  return a.sceneNumber - b.sceneNumber;
});

// Get related beats for this plot
const beats = await getCollection("beats");
const relatedBeats = beats.filter(beat => 
  beat.data.plots && 
  beat.data.plots.some(plotRef => plotRef.plot.id === plot.id)
);

// Sort beats by the beat number within the plot object
const sortedBeats = relatedBeats.sort((a, b) => {
  const aPlotData = a.data.plots?.find(p => p.plot.id === plot.id);
  const bPlotData = b.data.plots?.find(p => p.plot.id === plot.id);
  const aNum = aPlotData?.beatNumber || 0;
  const bNum = bPlotData?.beatNumber || 0;
  return aNum - bNum;
});

// Get parent/child plot relationships
const parentPlot = plot.data.parentPlot ? await getEntry(plot.data.parentPlot) : null;
const childPlots = (await getCollection("plots")).filter(p => 
  p.data.parentPlot && p.data.parentPlot.id === plot.id
);

// Extract tension data for this specific plot
// const plotTensionData = await extractTensionData(sortedBeats, plot.id, getEntry);

// Create plot-specific tension data with E1S2B1 labels
const plotSpecificTensionData = sortedBeats.map((beat, index) => {
  const plotData = beat.data.plots?.find(p => p.plot.id === plot.id);
  const scene = typeof beat.data.scene === 'string' ? beat.data.scene : beat.data.scene?.id || '';
  
  // Extract episode and scene numbers for E1S2 format
  const episodeMatch = scene.match(/episode-(\d+)\/s(\d+)-/);
  const sceneMatch = scene.match(/s(\d+)-/);
  
  // Get beat number for this plot from the plots array
  const beatNumber = plotData?.beatNumber || (() => {
    // Fallback: extract beat number from filename
    const filename = beat.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') || '';
    const beatMatch = filename.match(/beat-(\d+)/);
    return beatMatch ? parseInt(beatMatch[1]) : null;
  })();
  
  let label = '';
  if (episodeMatch && beatNumber) {
    label = `E${episodeMatch[1]}S${episodeMatch[2]}B${beatNumber}`;
  } else if (sceneMatch && beatNumber) {
    label = `S${sceneMatch[1]}B${beatNumber}`;
  } else {
    label = beat.id.split('/').pop()?.replace(/\.(md|mdx)$/, '') || 'Unknown';
  }
  
  return {
    label: label,
    tension: plotData?.tension || beat.data.tension || 0,
    overall: plotData?.tension || beat.data.tension || 0,
    timestamp: label
  };
});

// Debug logging for plot page
console.log(`Plot Page Debug - ${plot.data.title}:`);
console.log('- Plot ID:', plot.id);
console.log('- Related beats:', sortedBeats.map(b => ({ 
  id: b.id, 
  beatNumber: b.data.plots?.find(p => p.plot.id === plot.id)?.beatNumber, 
  scene: b.data.scene 
})));
console.log('- Tension data:', plotSpecificTensionData);

const beatTooltips = sortedBeats.map((beat) => {  
  const sceneId = typeof beat.data.scene === 'string'
    ? beat.data.scene
    : beat.data.scene?.id || '';
  const episodeMatch = sceneId.match(/episode-(\d+)\/s(\d+)-/);
  const sceneMatch = sceneId.match(/s(\d+)-/);
  const plotData = beat.data.plots?.find((p) => p.plot.id === plot.id);
  const tension = plotData?.tension ?? beat.data.tension ?? 0;
  
  return {
    scene: `E${episodeMatch?.[1] || '?'}S${episodeMatch?.[2] || sceneMatch?.[1] || '?'}`,
    tension
  };
});
---

<Layout title={`${plot.data.title} - Plots`}>
  <div class="container">
    <Breadcrumb 
      items={[
        { label: projectTitle, href: `/projects/${project}` },
        { label: "Plots", href: `/projects/${project}/plots` },
        { label: plot.data.title }
      ]} 
    />
    
    <div class="plot-header">
      <h1>{plot.data.title}</h1>
      
      <div class="plot-meta">
        <span class="plot-type">{plot.data.plotType}</span>
        
        {plot.data.plotLevel && (
          <span class="plot-level">{plot.data.plotLevel}-Plot</span>
        )}
        
        {parentPlot && (
          <span class="parent-plot">
            Child of <a href={`/plots/${parentPlot.id.replace('src/content/plots/', '').replace(/\.(md|mdx)$/, '')}`}>
              {parentPlot.data.title}
            </a>
          </span>
        )}
      </div>
      
      {plot.data.summary && (
        <p class="summary">{plot.data.summary}</p>
      )}
    </div>

    <!-- Plot Tension Graph -->
    {plotSpecificTensionData.length > 0 && (
        <TensionGraph 
          data={plotSpecificTensionData}
          title={`${plot.data.title} Beat Tension`}
          width={980}
          showOverall={false}
          showLegend={false}
          gradientColors={[
            // Use same color scale as PlotBeatCard tension boxes - neutral gray to bright red
            // 'rgb(0, 100, 225)', // Tension 1
            // 'rgb(250, 120, 120)'  // Tension 10
          ]}
          beatLinks={sortedBeats.map(beat => `/beats/${beat.id.replace('src/content/beats/', '').replace(/\.(md|mdx)$/, '')}`)}
          beatTooltips={beatTooltips}
        />
    )}

    <div class="plot-content">
      <div class="main-content">
        <div class="markdown">
          <Content />
        </div>
        
        {childPlots.length > 0 && (
          <div class="child-plots">
            <h2>Subplots</h2>
            <div class="plot-grid">
              {childPlots.map((childPlot) => (
                <div class="plot-card">
                  <h3>
                    <a href={`/plots/${childPlot.id.replace('src/content/plots/', '').replace(/\.(md|mdx)$/, '')}`}>
                      {childPlot.data.title}
                    </a>
                  </h3>
                  <p>{childPlot.data.summary}</p>
                  <span class="plot-type">{childPlot.data.plotType}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <aside class="sidebar">
        {plot.data.themes && plot.data.themes.length > 0 && (
          <div class="info-card">
            <h3>Themes</h3>
            <ul>
              {plot.data.themes.map((theme) => (
                <li>{theme.id.replace('-', ' ')}</li>
              ))}
            </ul>
          </div>
        )}
        
        {sortedBeats.length > 0 && (
          <div class="info-card">
            <h3>Plot Beats</h3>
            <div class="beats-grid">
              {sortedBeats.map((beat) => (
                <PlotBeatCard entry={beat} />
              ))}
            </div>
          </div>
        )}
        
        {sortedScenes.length > 0 && (
          <div class="info-card">
            <h3>Scenes</h3>
            <ul class="scene-list">
              {sortedScenes.map((scene) => (
                <li>
                  <a href={`/scenes/${scene.id.replace('src/content/scenes/', '').replace(/\.(md|mdx)$/, '')}`}>
                    {scene.episodeNumber > 0 ? `Ep ${scene.episodeNumber}, ` : ''}
                    Scene {scene.data.sceneNumber}: {scene.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 0;
    
  }

  .plot-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border);
  }

  .plot-header h1 {
    margin: 0 0 1rem 0;
    font-size: 2.5rem;
    font-weight: 700;
  }

  .plot-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .plot-type,
  .plot-level,
  .parent-plot {
    background: #000000;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .plot-type {
    background: var(--blue-subtle);
    color: var(--blue-light);
    border: 1px solid rgba(var(--blue-light-rgb),.6);

    font-weight: 400;
    letter-spacing: 0.75px;
  }

  .plot-level {
    background: rgba(var(--blue-dim-rgb), .5);
    border: 1px solid rgba(var(--blue-rgb),.7);
    color: var(--accent);
  }

  .parent-plot {
    background: var(--accent-subtle);
    color: #e65100;
  }

  .parent-plot a {
    color: inherit;
    text-decoration: none;
  }

  .parent-plot a:hover {
    text-decoration: underline;
  }

  .summary {
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--text-secondary);
    font-style: italic;
    margin: 0;
  }

  .tension-section {
    margin-bottom: 3rem;
    padding: 1rem;
    background: #ff0000;
    border-radius: 2px;
    border: 1px solid #006eff;
  }

  .tension-section h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 1rem;
  }

  .tension-description {
    color: #64748b;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    line-height: 1.5;
    background: #3300ff;
  }

  .plot-content {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 1rem;
    color: var(--text-secondary);
  }

  .main-content {
    min-width: 0;
  }

  .markdown {
    line-height: 1.7;
  }

  .markdown h1,
  .markdown h2,
  .markdown h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .markdown h1 {
    font-size: 2rem;
    padding-bottom: 0.5rem;
  }

  .markdown h2 {
    font-size: 1.5rem;
  }

  .markdown h3 {
    font-size: 1.25rem;
  }

  .markdown p {
    margin-bottom: 1rem;
  }

  .markdown ul,
  .markdown ol {
    margin-bottom: 1rem;
    padding-left: 2rem;
  }

  .markdown li {

    margin-bottom: 0.5rem;
  }

  .child-plots {
    margin-top: 3rem;
    padding-top: 2rem;
  }

  .plot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-top: 1rem;

  }

  .plot-card {
    background: var(--bg-raised);

    border-radius: 8px;
    padding: 1rem;
  }

  .plot-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
  }

  .plot-card h3 a {
    color: #333;
    text-decoration: none;
  }

  .plot-card h3 a:hover {
    color: #1976d2;
  }

  .plot-card p {
    margin: 0 0 0.5rem 0;
    font-size: 0.875rem;
    color: #666;
  }

  .sidebar {
    position: sticky;
    top: 2rem;
    height: fit-content;
  }

  .info-card {
    background: #2c292975;
    border: 1px solid #eee;
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .info-card h3 {
    margin: 0 0 1rem 0;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #b6acff;
    background: var(--bg-raised);

  }

  .info-card ul {
    margin: 0;
    padding-left: 1.5rem;
    font-size: 0.875rem;
    background: var(--bg-raised);
  }

  .beat-list {
    list-style: none;
    padding: 0;
    background: var(--bg-raised);

  }

  .beat-list li {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #ff0000;
    background: var(--bg-raised);

  }

  .beat-list li:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .beat-number,
  .beat-type,
  .tension {
    display: inline-block;
    background: #ff000088;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 500;
    margin-right: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .beat-link {
    text-decoration: none;
    color: inherit;
    display: block;
    padding: 0.5rem;
    background: rgb(255, 0, 0);
    border: 1px solid #ddd;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .beat-link:hover {
    background: var(--bg-raised);
    border-color: #999;
  }

  .beat-number {
    background: #0095ff;
    color: #1976d2;
  }

  .beat-type {
    background: #00ff00;
    color: #2e7d32;
  }

  .tension {
    background: #ff9d00;
    color: #e65100;
  }

  .beat-list p {
    margin: 0.5rem 0 0 0;
    font-size: 0.875rem;
    color: #333;
  }

  .beats-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .scene-list {
    list-style: none;
    padding: 0;
  }

  .scene-list li {
    margin-bottom: 0.5rem;
  }

  .scene-list a {
    display: block;
    padding: 0.5rem;
    background: rgb(10, 9, 9);
    border: 1px solid #ddd;
    border-radius: 4px;
    text-decoration: none;
    color: #333;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }

  .scene-list a:hover {
    background: #f5f5f5;
    border-color: #999;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .plot-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sidebar {
      position: static;
      order: -1;
    }

    .info-card {
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 1rem;
    }

    .plot-header h1 {
      font-size: 2rem;
    }

    .plot-meta {
      flex-direction: column;
      gap: 0.5rem;
    }

    .plot-grid {
      grid-template-columns: 1fr;
    }

    .tension-section {
      padding: 1rem;
      margin-bottom: 2rem;
    }
  }
</style>
