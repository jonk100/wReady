---
/**
 * /chords/index.astro
 *
 * Index page for all chord voicings. Cards show the chord name,
 * voicing label, and fingering information. Uses ChordCard components
 * for consistent styling with other collection pages.
 */

import fs from 'node:fs/promises';
import path from 'node:path';
import matter from 'gray-matter';
import type { CollectionEntry } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import ChordCard from "../../components/collection-cards/ChordCard.astro";
import ChordFilter from "../../components/filters/ChordFilter.astro";
import ChordAnalyser from "../../components/chords/ChordAnalyser.astro";
import ChordCreateForm from "../../components/chords/ChordCreateForm.astro";

export const prerender = false;

type ChordEntry = CollectionEntry<"chords">;

/**
 * Reads all chord .mdx files directly from disk at request time,
 * bypassing Astro's content store (which is populated at build time
 * and does not update between SSR requests).
 *
 * Returns an array shaped like CollectionEntry<"chords"> so ChordCard
 * and ChordFilter remain unchanged.
 *
 * @returns {Promise<Array<{ id: string, data: Record<string, any> }>>}
 */
const chordsDir = path.resolve(process.cwd(), 'src/content/chords');

const files = await fs.readdir(chordsDir);

const chords = (
  await Promise.all(
    files
      .filter(f => f.endsWith('.md') || f.endsWith('.mdx'))
      .map(async (file) => {
        const raw = await fs.readFile(path.join(chordsDir, file), 'utf-8');
        const { data } = matter(raw);
        const id = file.replace(/\.(md|mdx)$/, '');
        return { 
          id, 
          data: data as ChordEntry['data'], 
          collection: "chords" as const 
        };
      })
  )
).sort((a, b) => {
  const nameCompare = (a.data.displayName ?? '').localeCompare(b.data.displayName ?? '');
  if (nameCompare !== 0) return nameCompare;
  return a.id.localeCompare(b.id);
});

console.log(`Found ${chords.length} chord files on disk`);
---

<IndexLayout
  title="Chords"
  count={chords.length}
  description="Guitar chord voicing reference library."
>
  <ChordAnalyser />
  <ChordCreateForm />
  <ChordFilter chords={chords} />
  {chords.length === 0 ? (
    <p class="empty">No chords yet.</p>
  ) : (
    <ul class="grid grid--cols-4">
      {chords.map((entry) => (
        <li>
          <ChordCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-4 { grid-template-columns: repeat(4, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-4 { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-4 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 400px) {
    .grid--cols-4 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }

  /* Chord-specific CSS variables */
  :root {
    --chord-major: #3b82f6;
    --chord-minor: #ef4444;
    --chord-seventh: #8b5cf6;
  }
</style>