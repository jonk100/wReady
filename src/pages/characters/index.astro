---
/**
 * /characters/index.astro
 *
 * Index page for all characters across all projects.
 * Uses CharacterCard components for consistent styling with other collection pages.
 */

import { getCollection, type CollectionEntry } from "astro:content";
import IndexLayout from "../../layouts/IndexLayout.astro";
import CharacterCard from "../../components/collection-cards/CharacterCard.astro";
import TopFive from "../../components/projects/screenplays/stats/TopFive.astro";

const characters = await getCollection("characters");

// Sort by project, then by character name
const sorted = characters.sort((a, b) => {
  const projectCompare = a.data.project.id.localeCompare(b.data.project.id);
  if (projectCompare !== 0) return projectCompare;
  return a.data.name.localeCompare(b.data.name);
});
---

<IndexLayout
  title="Characters"
  count={sorted.length}
  description="All characters from all projects."
>
  <div>
    <TopFive project="her-majestys-displeasure" type="characters-by-lines" />
  </div>
  {sorted.length === 0 ? (
    <p class="empty">No characters yet.</p>
  ) : (
    
    <ul class="grid grid--cols-3">
      {sorted.map((entry) => (
        <li>
          <CharacterCard entry={entry} />
        </li>
      ))}
    </ul>
  )}
</IndexLayout>

<style>
  .grid {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .grid--cols-3 { grid-template-columns: repeat(3, 1fr); }

  /* Responsive: collapse to fewer columns on smaller screens */
  @media (max-width: 900px) {
    .grid--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid--cols-3 { grid-template-columns: 1fr; }
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-style: italic;
    padding: var(--space-8) 0;
    text-align: center;
  }
</style>
