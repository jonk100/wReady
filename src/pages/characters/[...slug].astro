---
import { getEntry, getCollection, render } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";
import type { CollectionEntry } from "astro:content";
import Breadcrumb from "../../components/Breadcrumb.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import CharacterLines from "../../components/projects/screenplays/stats/CharacterLines.astro";

/**
 * Generate static paths for character pages
 */
export async function getStaticPaths() {
  const characters = await getCollection("characters");

  return characters.map((character) => {
    const slug = character.id
      .replace("src/content/characters/", "")
      .replace(/\.(md|mdx)$/, "");

    return {
      params: { slug },
      props: { character },
    };
  });
}

const { character } = Astro.props;
const { Content, headings } = await render(character);

// Extract project from character data
const project = character.data.project.id || 'unknown';

// Get project data for title
let projectTitle = project;
try {
  if (project) {
    const projectData = await getEntry(character.data.project) as any;
    projectTitle = projectData?.data?.title || project;
  }
} catch (error) {
  // Use project slug as fallback
  console.warn(`Could not load project data for ${project}:`, error);
}

// Get related scenes this character appears in
const scenes = await getCollection("scenes");
const relatedScenes = scenes.filter(scene => 
  scene.data.characters && 
  scene.data.characters.some(charRef => charRef.id === character.id)
);

// Sort scenes by number
const sortedScenes = relatedScenes.sort((a, b) => {
  const aNum = parseInt(String(a.data.sceneNumber)) || 0;
  const bNum = parseInt(String(b.data.sceneNumber)) || 0;
  return aNum - bNum;
});

const characterId = character.id.replace(`${project}/`, '');
const characterSlug = characterId;
---

<Layout title={`${character.data.name} - Characters`}>
  <div class="container">
    <Breadcrumb 
      items={[
        { label: projectTitle, href: `/projects/${project}` },
        { label: "Characters", href: `/projects/${project}/characters` },
        { label: character.data.name }
      ]} 
    />
    
    <div class="character-header">
      <h1>{character.data.name}</h1>
      
      <div class="character-meta">
        {character.data.role && (
          <span class="role">{character.data.role}</span>
        )}
        
        {character.data.occupation && (
          <span class="occupation">{character.data.occupation}</span>
        )}
        
        {character.data.age && (
          <span class="age">
            Age: {character.data.age.act_1 || 'Unknown'} (Act 1)
          </span>
        )}
      </div>
      
      {character.data.description && (
        <p class="description">{character.data.description}</p>
      )}
    </div>

    <div class="character-content">
      <div class="main-content">
        <div class="markdown">
          <Content />
        </div>
      </div>

      <aside class="sidebar">
        <!-- {character.data.first_appearance && (
          <div class="info-card">
            <h3>First Appearance</h3>
            <p>{character.data.first_appearance}</p>
          </div>
        )}
        
        {character.data.last_appearance && (
          <div class="info-card">
            <h3>Last Appearance</h3>
            <p>{character.data.last_appearance}</p>
          </div>
        )} -->
        
        {character.data.themes && character.data.themes.length > 0 && (
          <div class="info-card">
            <h3>Themes</h3>
            <ul>
              {character.data.themes.map((theme) => (
                <li>{theme.id.replace('-', ' ')}</li>
              ))}
            </ul>
          </div>
        )}
        
        {sortedScenes.length > 0 && (
          <div class="info-card">
            <h3>Scenes</h3>
            <ul class="scene-list">
              {sortedScenes.map((scene) => (
                <li>
                  <a href={`/scenes/${scene.id.replace('src/content/scenes/', '').replace(/\.(md|mdx)$/, '')}`}>
                    Scene {scene.data.sceneNumber}: {scene.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    <div class="toc-sidebar">
      <TableOfContents headings={headings} />
      <CharacterLines project={project} character={characterSlug} />
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem;
  }

  .character-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid rgba(var(--accent-rgb), 0.3);
  }

  .character-header h1 {
    margin: 0 0 1rem 0;
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .character-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .role,
  .occupation,
  .age {
    padding: 0.25rem .75rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid var(--border-strong);

  }

  .role {
    background: var(--bg-raised) !important;
    color: var(--text-secondary);
    border: 1px solid var(--border-strong);
  }

  .occupation {
    background: var(--bg-card) !important;
    color: var(--text-secondary);
  }

  .age {
    background: var(--bg-raised) !important;
    color: var(--text-secondary);

  }

  .description {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    font-weight: 400
    font-style: italic;
    margin: 0;
  }

  .character-content {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
  }

  .main-content {
    min-width: 0;
  }

  .toc-sidebar {
    position: fixed;
    width: 260px;
    overflow-y: auto;
    background: var(--bg);
    z-index: 30;
    top: 0px;
    left: 0;
  }

  .container {
    margin-left: 350px;
  }

  .markdown {
    line-height: 1.4;
  }

  .markdown h1,
  .markdown h2,
  .markdown h3 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .markdown h4 {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }


  .sidebar {
    position: static;
    height: auto;
  }

  .info-card {
    background: var(--bg-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: .5rem;
    margin-bottom: 1.5rem;
  }

  .info-card h3 {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--accent-dim);
    padding-left: 1rem;
  }

  .info-card p {
    margin: 0;
    font-size: 0.875rem;
  }

  .info-card ul {
    margin: 0;
    font-size: 0.875rem;
  }

  .scene-list {
    list-style: none;
    padding: 0;
  }

  .scene-list li {
    margin-bottom: 0.5rem;
  }

  .scene-list a {
    display: block;
    padding: 0.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 2px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: all 0.2s ease;
    shadow: var(--shadow-card);
  }

  .scene-list a:hover {
    background: var(--bg-card-hover);
    border-color: var(--border);
    shadow: var(--shadow-card-hover);
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .toc-sidebar {
      display: none;
    }

    .character-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 900px) {
    .character-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sidebar {
      position: static;
      order: -1;
    }

    .info-card {
      margin-bottom: 1rem;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 1rem;
    }

    .character-header h1 {
      font-size: 2rem;
    }

    .character-meta {
      flex-direction: column;
      gap: 0.5rem;
    }

    .character-content {
      gap: 1.5rem;
    }
  }
</style>
