---
import { type CollectionEntry } from 'astro:content';

interface Props {
  scene: CollectionEntry<'scenes'>;
  episodeNumber?: number;
  episodeFilterValue?: string | null;
  location?: CollectionEntry<'locations'>[];
  project?: string;
  characters?: CollectionEntry<'characters'>[];

}

const { 
  scene,
  episodeNumber,
  episodeFilterValue,
  location,
  project,
  characters,
} = Astro.props;
---
<div class="header">
  <div class="header-top">
    <h1>{scene.data.title}</h1>
    <button class="btn-edit" id="edit-scene-btn">Edit Scene</button>
  </div>

  <div class="meta">
    {episodeNumber && episodeFilterValue && (
      <a href={`/projects/${project}/scenes?episode=${encodeURIComponent(episodeFilterValue)}`} class="episode">
        E{episodeNumber}
      </a>
    )}
    <span class="scene-num">S{scene.data.sceneNumber}</span>

    <span class="int-ext">{scene.data.intOrExt}</span>

    {
      location?.length ? (
        location[0]?.id ? (
          <a href={`/locations/${location[0].id}`} class="location">
            {location.map((loc) => loc.data.name).join(", ")}
          </a>
        ) : (
          <span class="location">Unknown Location</span>
        )
      ) : null
    }

    <span class="time">{scene.data.timeOfDay}</span>

    {characters && characters.length > 0 && (
      <details class="characters-dropdown">
        <summary class="characters-toggle">Characters</summary>

        <div class="character-list">
          {characters.map((character) => (
            character && character.id ? (
              <a href={`/characters/${character.id}`} class="character-link">
                {character?.data?.name || 'Unknown'}
              </a>
            ) : (
              <span class="character-link character-missing">
                {character?.data?.name || 'Unknown Character'}
              </span>
            )
          ))}
        </div>
      </details>
    )}
  </div>
</div>

<style>
/* ═══════════════════════════════════════════
  Header
═══════════════════════════════════════════ */

.header {
  position: relative;
  margin-bottom: 2rem;
  padding-bottom: 1rem;
  border-bottom: 2px solid #eee;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.header h1 {
  margin: 0;
}

.btn-edit {
  padding: 0.625rem 1.25rem;
  background: #1976d2;
  color: white;
  border: none;
  border-radius: 4px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}

.btn-edit:hover {
  background: #1565c0;
}

/* ═══════════════════════════════════════════
   Meta pills
═══════════════════════════════════════════ */

.meta {
  display: flex;
  gap: 0.5rem;
  align-items: center;
  flex-wrap: wrap;
}

.episode,
.scene-num,
.int-ext,
.location,
.time,
.characters-toggle {
  background: var(--accent-subtle);
  color: var(--text-primary);
  padding: 0.5rem 1rem;
  border-radius: 4px;
  font-size: 0.875rem;
  font-weight: bold;
  border: 1px solid var(--bg-card);
  box-shadow: -3px 0px 3px var(--accent-subtle);
}

.episode {
  color: var(--blue-light);
  background: rgba(26, 90, 138, .75);
  text-decoration: none;
}

.episode:hover {
  background: rgba(26, 90, 138, 1);
}

.scene-num {
  color: #e8f5e8;
  background: rgba(46, 125, 50, .75);
}

.int-ext {
  color: #fff3e0;
  background: rgba(230, 81, 0, .75);
}

.location {
  color: #e3f2fd;
  background: rgba(26, 117, 209, .75);
  text-decoration: none;
}

.location:hover {
  background: rgba(26, 117, 209, 1);
}

.time {
  color: #f3e5f5;
  background: rgba(123, 31, 162, .75);
}

/* ═══════════════════════════════════════════
   Characters dropdown
═══════════════════════════════════════════ */

.characters-dropdown {
  display: contents;
  position: static;
}

.characters-toggle {
  list-style: none;
  cursor: pointer;
  color: var(--text-primary);
  /* background: linear-gradient(90deg, var(--blue-subtle) 0%, var(--blue-dark) 35%); */
  background: var(--blue-subtle);
  border: 1px solid transparent;
  border-right: none;
  transition: ease-in-out 0.3s all;
}

.characters-toggle:hover {
  background: var(--bg-card);
  transition: ease 0.3s all;
}

.characters-toggle::-webkit-details-marker {
  display: none;
}

.characters-dropdown[open] .characters-toggle {
  background: linear-gradient(90deg, var(--bg), var(--blue-subtle) 50%);
  color: var(--text-primary);
  border: 1px solid var(--accent-subtle);
  border-left: none;
  transition: ease 0.3s all;
  box-shadow: -6px 0px 0px var(--accent-subtle);
  margin-right: -.5rem;
  border-radius: 4px 0 0 4px;
  padding-right: 1.5rem;

}

.characters-dropdown[open] {
  flex-basis: 100%;
}

.character-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  width: 100%;
  padding: 0.3125rem;
  border: 1px solid var(--blue-subtle);
  border-left: none;
  /* margin-left: -.5rem; */
  width: 100%;
  background: linear-gradient(90deg, var(--blue-subtle) 60%, var(--bg));
  border-radius: 0 4px 4px 0;
  box-shadow: 6px 0px 0px var(--accent-subtle);

}

.character-link {
  color: var(--text-secondary);
  background-color: var(--bg-card-subtle);
  border: 1px solid var(--accent-subtle);
  box-shadow: inset;
  padding: 0.125rem 1rem;
  border-radius: .25rem;
  font-weight: 500;
  white-space: nowrap;
  text-decoration: none;
  cursor: pointer;
  font-size: 0.875rem;
}

.character-link:hover {
  background: var(--accent-subtle);
  color: var(--text-primary);
}

.character-missing {
  opacity: 0.6;
  cursor: default;
}

.character-missing:hover {
  background: #f0f0f0;
}
</style>