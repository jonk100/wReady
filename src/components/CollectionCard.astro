---
/**
 * CollectionCard.astro
 *
 * Renders a single card from a collection entry.
 * Works directly with Astro collection entries without additional mapping.
 *
 * @prop entry    - Collection entry from getCollection()
 * @prop variant  - Optional layout variant (default: "standard")
 *                  "standard" — title + subtitle + meta + badge
 *                  "image"    — poster/thumbnail on the left
 */

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<any>;
  variant?: "standard" | "image" | "auto";
}

const { entry, variant = "auto" } = Astro.props;

// Extract data based on collection type
const data = (entry as any).data;
const href = `/${(entry as any).collection}/${(entry as any).id}`;

// Determine if we should use image variant
const useImageVariant = variant === "image" || (variant === "auto" && data.poster);

// Status color mapping
const statusColorMap: Record<string, string> = {
  draft:        "var(--status-draft)",
  published:    "var(--status-published)",
  complete:     "var(--status-complete)",
  revised:      "var(--status-progress)",
  outline:      "var(--status-draft)",
  "first-draft": "var(--status-progress)",
  locked:       "var(--status-locked)",
  development:  "var(--status-draft)",
  "in-progress": "var(--status-progress)",
  idea:         "var(--status-idea)",
  demo:         "var(--status-draft)",
  recording:    "var(--status-progress)",
  mixing:       "var(--status-progress)",
  mastered:     "var(--status-complete)",
  arranged:     "var(--status-progress)",
  recorded:     "var(--status-complete)",
  released:     "var(--status-complete)",
  main:         "var(--status-locked)",
  sub:          "var(--status-progress)",
};

// Resolve badge colour
const badgeColor = data.status ? (statusColorMap[data.status] ?? "var(--status-draft)") : null;
---

<a
  href={href}
  class:list={["card", useImageVariant && "card--image"]}
  aria-label={data.title}
>
  {useImageVariant && data.poster && (
    <div class="card__image-wrap">
      <img src={data.poster} alt={data.title} loading="lazy" />
    </div>
  )}

  <div class="card__body">
    <div class="card__top">
      <h3 class="card__title">{data.title}</h3>
      {badgeColor && (
        <span class="card__badge" style={`--badge-color: ${badgeColor}`}>
          {data.status}
        </span>
      )}
    </div>

    {data.subtitle && (
      <p class="card__subtitle">{data.subtitle}</p>
    )}

    {(data.category || data.year || data.pubDate) && (
      <div class="card__footer">
        <span class="card__meta">
          {data.category && data.year ? `${data.category} · ${data.year}` : 
           data.category ? data.category : 
           data.year ? data.year :
           data.pubDate ? data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : ""}
        </span>
      </div>
    )}
  </div>
</a>

<style>
  /* ── Base card ─────────────────────────────── */

  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
    box-shadow: var(--shadow-card);
  }

  .card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ── Image variant ─────────────────────────── */

  .card--image {
    flex-direction: row;
    align-items: stretch;
  }

  .card__image-wrap {
    flex-shrink: 0;
    width: 80px;
    overflow: hidden;
  }

  .card--image .card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }

  /* ── Body ──────────────────────────────────── */

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
    flex: 1;
    min-width: 0; /* allow text truncation */
  }

  /* ── Top row: title + badge ────────────────── */

  .card__top {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    justify-content: space-between;
  }

  .card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
    /* Allow wrapping but limit to 3 lines */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Badge ─────────────────────────────────── */

  .card__badge {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--badge-color, var(--status-draft));
    border: 1px solid var(--badge-color, var(--status-draft));
    border-radius: var(--radius-sm);
    padding: 0.15em 0.5em;
    opacity: 0.85;
    white-space: nowrap;
    /* Align badge with first line of title */
    margin-top: 0.15em;
  }

  /* ── Subtitle ──────────────────────────────── */

  .card__subtitle {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    /* Clamp to 2 lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Footer: meta + detail ─────────────────── */

  .card__footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }

  .card__meta {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .card__detail {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-left: auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>