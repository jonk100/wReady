---
/**
 * ScoreField.astro
 *
 * A reusable score + analysis textarea pair for review forms.
 *
 * Renders a numeric score input (1–10) and a textarea for the written
 * analysis beneath it, both labelled and grouped together.
 *
 * Usage:
 *   <ScoreField
 *     id="writingScore"
 *     label="Writing Analysis"
 *     bodyId="writingBody"
 *     placeholder="Discuss narrative logic, dialogue, character arcs…"
 *   />
 *
 * The `id` prop is used as the `name` attribute on the score input so
 * FormData picks it up with the correct key. Likewise `bodyId` is used
 * as the `name` attribute on the textarea.
 */

export type Props = {
  /** Name/id for the score <input>. e.g. "writingScore" */
  id: string;
  /** Human-readable section label. e.g. "Writing Analysis" */
  label: string;
  /** Name/id for the body <textarea>. e.g. "writingBody" */
  bodyId: string;
  /** Placeholder text for the textarea. */
  placeholder?: string;
  /** Pre-filled score value. */
  initialScore?: number;
  /** Pre-filled body text. */
  initialBody?: string;
};

const {
  id,
  label,
  bodyId,
  placeholder = 'Write your analysis here…',
  initialScore,
  initialBody = '',
} = Astro.props;
---

<div class="score-field">
  <div class="score-header">
    <label for={id} class="score-label">{label}</label>
    <input
      type="number"
      id={id}
      name={id}
      class="score-input"
      min="1"
      max="10"
      step="0.1"
      placeholder="1–10"
      value={initialScore ?? ''}
    />
  </div>

  <textarea
    id={bodyId}
    name={bodyId}
    class="score-body"
    rows={5}
    placeholder={placeholder}
  >{initialBody}</textarea>
</div>

<style>
  .score-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    grid-column: 1 / -1;
  }

  .score-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .score-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex: 1;
  }

  .score-input {
    width: 80px;
    flex-shrink: 0;
    text-align: center;
  }

  .score-body {
    resize: vertical;
    min-height: 100px;
  }
</style>