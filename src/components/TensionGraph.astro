---
import type { CollectionEntry } from "astro:content";
import Tooltip from "./primitive/Tooltip.astro";

interface Props {
  data: TensionData[];
  width?: number;
  height?: number;
  title?: string;
  showOverall?: boolean;
  colors?: string[];
  gradientColors?: string[]; // New prop for gradient line colors
  showLegend?: boolean; // Add showLegend prop
  beatLinks?: string[]; // Add beat links for data points
}

interface TensionData {
  label: string;
  tension: number;
  overall?: number;
  timestamp?: string;
}

const { 
  data, 
  width = 800, 
  height = 400, 
  title = "Tension Over Time",
  showOverall = true,
  colors = ["#3b82f6", "#ef4444", "#10b981", "#f59e0b", "#8b5cf6", "#ec4899"],
  gradientColors = undefined, // New prop for gradient line colors
  showLegend = true, // Use showLegend prop
  beatLinks = undefined // Beat links for data points
} = Astro.props;

const getTensionColor = (tension: number): string => {
  const ratio = tension / 10;

  const red = Math.round(255 * ratio);
  const blue = Math.round(255 * (1 - ratio));

  return `rgb(${red}, 0, ${blue})`;
};

// Generate unique plot names for the data
const plotNames = [...new Set(data.map(d => d.label))];
const hasOverall = data.some(d => d.overall !== undefined);

// Calculate scales
const maxTension = Math.max(
  ...data.map(d => Math.max(d.tension, d.overall || 0))
);
const minTension = 0;
const padding = { top: 40, right: 40, bottom: 60, left: 60 };
const graphWidth = width - padding.left - padding.right;
const graphHeight = height - padding.top - padding.bottom;

// Scale functions - always use 10 as max for y-axis consistency
const xScale = (index: number) => (index / (data.length - 1)) * graphWidth + padding.left;
const yScale = (value: number) => graphHeight - ((value - minTension) / (10 - minTension)) * graphHeight + padding.top;

// Generate path data for each plot
const plotPaths = plotNames.map((plotName, plotIndex) => {
  const plotData = data.filter(d => d.label === plotName);
  const points = plotData.map((d, i) => {
    const x = xScale(data.indexOf(d));
    const y = yScale(d.tension);
    return `${i === 0 ? 'M' : 'L'} ${x} ${y}`;
  }).join(' ');
  
  // Use gradient colors if provided, otherwise fall back to solid colors
  const strokeColor = gradientColors ? undefined : colors[plotIndex % colors.length];
  
  return {
    name: plotName,
    path: points,
    color: colors[plotIndex % colors.length]
  };
});

// Special case: single gradient line (when gradientColors provided but we want one continuous line)
const singleGradientPath = gradientColors ? data.map((d, i) => {
  const x = xScale(i);
  const y = yScale(d.tension);
  return `${i === 0 ? 'M' : 'L'} ${x} ${y}`;
}).join(' ') : null;

// Generate overall tension path if available
let overallPath = '';
if (hasOverall && showOverall) {
  const points = data.map((d, i) => {
    const x = xScale(i);
    const y = yScale(d.overall || 0);
    return `${i === 0 ? 'M' : 'L'} ${x} ${y}`;
  }).join(' ');
  overallPath = points;
}

// Generate grid lines - always use 10-point scale
const gridLines = [];
for (let i = 0; i <= 10; i++) {
  const y = yScale(i);
  gridLines.push({ y, tension: i });
}

// Generate x-axis labels
const xLabels = data.map((d, i) => {
  const x = xScale(i);
  // Use the label directly instead of timestamp
  return { x, label: d.label || d.timestamp || `Point ${i + 1}` };
});
---
    <details class="tension-graph-container">

      <summary>
        <h3 class="graph-title gradient-text">{title}</h3>
        <svg class="chevron" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
          <polyline points="3,5 8,11 13,5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </summary>
      
    <svg width={width} height={height} class="tension-graph">
      <defs>
      <linearGradient
        id="main-gradient"      x1="0%"
        y1="100%"
        x2="0%"
        y2="0%"
      >
        <!-- Low tension -->
        <stop
          offset="0%"
          stop-color="rgb(0, 0, 200)"
          stop-opacity="0.15"
        />

        <stop
          offset="45%"
          stop-color="rgb(0, 0, 200)"
          stop-opacity="1"
        />

        <!-- Transition zone -->
        <stop
          offset="55%"
          stop-color="rgb(200, 0, 0)"
          stop-opacity="0.15"
        />

        <!-- High tension -->
        <stop
          offset="100%"
          stop-color="rgb(200, 0, 0)"
          stop-opacity="1"
        />
      </linearGradient>
    </defs>
      <!-- Grid lines -->
      {gridLines.map(({ y, tension }) => (
        <g class="grid-line">
          <line 
            x1={padding.left} 
            y1={y} 
            x2={width - padding.right} 
            y2={y} 
            stroke="rgba(255,255,255,.15)"
            stroke-width="1"
          />
          {/* y-axis labels */}
          <text 
            x={padding.left - 10} 
            y={y + 5} 
            text-anchor="end" 
            class="axis-label"
            font-size="8"
            fill="rgba(255,255,255, 0.75)"
          >
            {tension}
          </text>
        </g>
      ))}
      
      <!-- Axes -->
      <line 
        x1={padding.left} 
        y1={padding.top} 
        x2={padding.left} 
        y2={height - padding.bottom} 
        stroke="url(#main-gradient)" 
        stroke-width="2"
      />
      <line 
        x1={padding.left} 
        y1={height - padding.bottom} 
        x2={width - padding.right} 
        y2={height - padding.bottom} 
        stroke="rgba(0, 0, 0, 0.25)" 
        stroke-width="1"
      />
      
      <!-- Plot lines -->
      {gradientColors ? (
        <g class="plot-line">
          <defs>
            <linearGradient
              id="main-gradient"
              x1="0%"
              y1="100%"
              x2="0%"
              y2="0%"
            >
              {/* <!-- Low tension --> */}
              <stop
                offset="0%"
                stop-color={gradientColors[0]}
                stop-opacity="0.15"
              />

              <stop
                offset="45%"
                stop-color={gradientColors[0]}
                stop-opacity="1"
              />

              <!-- High tension -->
              <stop
                offset="55%"
                stop-color={gradientColors[1]}
                stop-opacity="0.15"
              />

              <stop
                offset="100%"
                stop-color={gradientColors[1]}
                stop-opacity="1"
              />
            </linearGradient>
          </defs>
          <path 
            d={singleGradientPath} 
            stroke="url(#main-gradient)" 
            stroke-width="2" 
            fill="none"
            stroke-linejoin="round"
            stroke-linecap="round"
          />

          {/* <!-- Data points --> */}
          {data.map((d, i) => {
            const x = xScale(i);
            const y = yScale(d.tension);
            const beatLink = beatLinks?.[i];
            
            if (beatLink) {
              return (
                <a href={beatLink} class="data-point-link">

                  <circle 
                    cx={x} 
                    cy={y} 
                    r="30" 
                    fill="transparent"
                    class={`data-link-boundary boundary-${i}`} 
                  />
                  <circle 
                    cx={x} 
                    cy={y} 
                    r="5" 
                    fill={getTensionColor(d.tension)}
                    class="data-point"
                  />
                </a>
              );
            } else {
              return (
                <circle 
                  cx={x} 
                  cy={y} 
                  r="4" 
                  fill={getTensionColor(d.tension)}
                  class="data-point"
                />
              );
            }
          })}
        </g>
      ) : (
        plotPaths.map(({ name, path, color }) => (
          <g class="plot-line">
            <path 
              d={path} 
              stroke={color} 
              stroke-width="2" 
              fill="none"
              stroke-linejoin="round"
              stroke-linecap="round"
            />
            <!-- Data points -->
            {data.filter(d => d.label === name).map((d, i) => {
              const dataIndex = data.indexOf(d);
              const x = xScale(dataIndex);
              const y = yScale(d.tension);
              return (
                <circle 
                  cx={x} 
                  cy={y} 
                  r="4" 
                  fill={color}
                  class="data-point"
                />
              );
            })}
          </g>
        ))
      )}
      
      <!-- Overall tension line -->
      {hasOverall && showOverall && (
        <g class="overall-line">
          <path 
            d={overallPath} 
            stroke="#000000" 
            stroke-width="3" 
            fill="none"
            stroke-dasharray="5,5"
            stroke-linejoin="round"
            stroke-linecap="round"
          />
          {/* <!-- Data points --> */}
          {data.map((d, i) => {
            const x = xScale(i);
            const y = yScale(d.overall || 0);
            return (
              <circle 
                cx={x} 
                cy={y} 
                r="4" 
                fill="#000000"
                class="data-point"
              />
            );
          })}
        </g>
      )}
      
      <!-- X-axis labels -->
      {xLabels.map(({ x, label }) => (
        <text 
          x={x} 
          y={height - padding.bottom + 20} 
          text-anchor="middle" 
          class="axis-label"
          font-size="8"
          fill="lightgray"
          transform={`rotate(-45, ${x}, ${height - padding.bottom + 20})`}
        >
          {label}
        </text>
      ))}
    </svg>
    
    <!-- Legend -->
    {showLegend && (
      <div class="legend">
        {plotPaths.map(({ name, color }) => (
          <div class="legend-item">
            <div class="legend-color" style={`background-color: ${color}`}></div>
            <span class="legend-label">{name}</span>
          </div>
        ))}
        {hasOverall && showOverall && (
          <div class="legend-item">
            <div class="legend-color overall"></div>
            <span class="legend-label">Overall Tension</span>
          </div>
        )}
      </div>
    )}

    <!-- TOOLTIP for DATA POINTS -->  
    {data.map((d, i) => {
      const beatLink = beatLinks?.[i];
      if (beatLink) {
        return (
          <Tooltip id={`tooltip-${i}`} anchor={`boundary-${i}`}>
            {d.label}
          </Tooltip>
        );
      }
      return null;
    })}
  </details>

<style>
  .tension-graph-container {
    background: rgba(62, 65, 11, 0.565);
    border-radius: 4px;
    padding: 0;                      /* was 2rem — now handled per-section */
    margin: 20px 0;
    border: 1px solid #d1d5db7b;
    overflow: hidden;                /* keeps border-radius clean */
  }

  /* Remove the default triangle marker */
  .tension-graph-container > summary {
    list-style: none;
    padding: 1.5rem 2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    user-select: none;
  }

  .tension-graph-container > summary::-webkit-details-marker {
    display: none;
  }

  .graph-title {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 3px;
    flex: 1;
  }

  .chevron {
    width: 16px;
    height: 16px;
    stroke: rgba(255, 255, 255, 0.5);
    fill: none;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  details[open] .chevron {
    transform: rotate(180deg);
  }

  .graph-body {
    padding: 0 2rem 2rem;
  }
  .graph-title {
    font-size: 18px;
    color: linear-gradient(to right, rgb(138, 138, 255), rgb(255, 123, 123) 50%);
  }

  .gradient-text {
  background: linear-gradient(to right, rgb(121, 121, 255),  lightblue 10%, lightblue 20%,  rgb(255, 125, 125) 40%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
  
  .tension-graph {
    background: rgba(255, 255, 255, 0);
    border-radius: 4px;
  }
  
  .grid-line {
    opacity: 0.5;
  }
  
  .axis-label {
    font-family: system-ui, -apple-system, sans-serif;
  }
  
  .data-point {
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .data-point-link {
    text-decoration: none;
  }
  
  .data-point-link:hover .data-point {
    r: 6;
    filter: brightness(1.2);
  }
  
  .data-point:hover {
    r: 6;
    filter: brightness(1.2);
  }
  
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 15px;
    justify-content: center;
  }
  
  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #4b5563;
  }
  
  .legend-color {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #d1d5db;
  }
  
  .legend-color.overall {
    background: repeating-linear-gradient(
      45deg,
      #000000,
      #000000 3px,
      #ffffff 3px,
      #ffffff 6px
    );
    border-color: #000000;
  }
  
  @media (max-width: 768px) {
    .tension-graph-container {
      padding: 15px;
      overflow-x: auto;
    }
    
    .legend {
      justify-content: flex-start;
    }
  }
</style>
