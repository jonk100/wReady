---
/**
 * TopFive.astro
 *
 * Interactive top 5 stats display for screenplays.
 * Shows top characters by lines/appearances, top locations, etc.
 *
 * @example
 * <TopFive project="her-majestys-displeasure" type="characters-by-lines" />
 * <TopFive project="her-majestys-displeasure" type="locations" />
 * <TopFive project="her-majestys-displeasure" type="episodes" />
 */

import { getCollection } from "astro:content";
import { labelFromId } from "../../../../utils/screenwriting/helpers";

interface Props {
  project: string;
  type?: "characters-by-lines" | "characters-by-appearances" | "locations" | "episodes" | "character-pairs";
}

const { project, type = "characters-by-lines" } = Astro.props;

// Fetch all scenes for this project
let allScenes = await getCollection("scenes");
allScenes = allScenes.filter((s) => s.data.project.id === project);

// Count lines function
function countLines(body: string, charId: string): number {
  const slug = charId.split("/").pop()!.toLowerCase();
  const cueRegex = /^c-(.+)$/gm;
  let count = 0;
  let match: RegExpExecArray | null;
  while ((match = cueRegex.exec(body)) !== null) {
    const raw = match[1]
      .replace(/\(CONT'D\)/gi, "")
      .trim()
      .toLowerCase()
      .replace(/\s+/g, "-");
    if (raw === slug || slug.includes(raw)) count++;
  }
  return count;
}

interface TopItem {
  rank: number;
  name: string;
  value: number;
  meta?: string;
  id?: string;
  href?: string;
}

let topItems: TopItem[] = [];
let typeLabel = "";
let valueLabel = "Count";

// Generate top 5 based on type
if (type === "characters-by-lines") {
  typeLabel = "Characters by Total Lines";
  valueLabel = "Lines";

  const characterLines = allScenes.reduce(
    (acc, scene) => {
      if (!scene.body) return acc;
      for (const char of scene.data.characters) {
        acc[char.id] = (acc[char.id] ?? 0) + countLines(scene.body, char.id);
      }
      return acc;
    },
    {} as Record<string, number>
  );

  topItems = Object.entries(characterLines)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([id, lines], idx) => ({
      rank: idx + 1,
      name: labelFromId(id),
      value: lines,
      id,
      href: `/characters/${id}`,
    }));
} else if (type === "characters-by-appearances") {
  typeLabel = "Characters by Scene Appearances";
  valueLabel = "Scenes";

  const characterAppearances = allScenes.reduce(
    (acc, scene) => {
      for (const char of scene.data.characters) {
        acc[char.id] = (acc[char.id] ?? 0) + 1;
      }
      return acc;
    },
    {} as Record<string, number>
  );

  topItems = Object.entries(characterAppearances)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([id, count], idx) => ({
      rank: idx + 1,
      name: labelFromId(id),
      value: count,
      id,
      href: `/characters/${id}`,
    }));
} else if (type === "locations") {
  typeLabel = "Most Used Locations";
  valueLabel = "Scenes";

  const locationCounts = allScenes.reduce(
    (acc, scene) => {
      for (const loc of scene.data.location) {
        acc[loc.id] = (acc[loc.id] ?? 0) + 1;
      }
      return acc;
    },
    {} as Record<string, number>
  );

  topItems = Object.entries(locationCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([id, count], idx) => ({
      rank: idx + 1,
      name: labelFromId(id),
      value: count,
      id,
    }));
} else if (type === "episodes") {
  typeLabel = "Episodes by Scenes";
  valueLabel = "Scenes";

  const episodeCounts = allScenes.reduce(
    (acc, scene) => {
      if (scene.data.episode?.id) {
        acc[scene.data.episode.id] = (acc[scene.data.episode.id] ?? 0) + 1;
      }
      return acc;
    },
    {} as Record<string, number>
  );

  topItems = Object.entries(episodeCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([id, count], idx) => ({
      rank: idx + 1,
      name: labelFromId(id),
      value: count,
      id,
    }));
} else if (type === "character-pairs") {
  typeLabel = "Most Frequent Character Pairs";
  valueLabel = "Scenes";

  const pairCounts: Record<string, number> = {};

  for (const scene of allScenes) {
    const chars = scene.data.characters.map((c) => c.id).sort();
    for (let i = 0; i < chars.length; i++) {
      for (let j = i + 1; j < chars.length; j++) {
        const pair = `${chars[i]}|${chars[j]}`;
        pairCounts[pair] = (pairCounts[pair] ?? 0) + 1;
      }
    }
  }

  topItems = Object.entries(pairCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5)
    .map(([pair, count], idx) => {
      const [char1, char2] = pair.split("|");
      return {
        rank: idx + 1,
        name: `${labelFromId(char1)} & ${labelFromId(char2)}`,
        value: count,
        meta: "scenes together",
      };
    });
}
---

<div class="top-five-card">
  <!-- Collapsed: Summary -->
  <details>
    <summary>
      <div class="top-five-trigger">
        <div class="trigger-main">
          <p class="trigger-label">{typeLabel}</p>
          <p class="trigger-top">🥇 {topItems[0]?.name}</p>
        </div>
        <div class="chevron">↓</div>
      </div>
    </summary>

      <!-- Expanded: Table -->
    <div class="top-five-expanded">
      <div class="table-header">
        <h2>{typeLabel}</h2>
      </div>

      <div class="table-wrapper">
        <table class="top-five-table">
          <thead>
            <tr>
              <th class="rank-col">Rank</th>
              <th class="name-col">Name</th>
              <th class="value-col">{valueLabel}</th>
            </tr>
          </thead>
          <tbody>
            {topItems.map((item) => (
              <tr class="table-row">
                <td class="rank-cell">
                  <span class="rank-badge">
                    {item.rank === 1 && "🥇"}
                    {item.rank === 2 && "🥈"}
                    {item.rank === 3 && "🥉"}
                    {item.rank > 3 && `#${item.rank}`}
                  </span>
                </td>
                <td class="name-cell">
                  {item.href ? (
                    <a href={item.href} class="name-link">
                      {item.name}
                    </a>
                  ) : (
                    <span>{item.name}</span>
                  )}
                </td>
                <td class="value-cell">{item.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </details>
</div>

