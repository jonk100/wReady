<style>
  .top-five-card {
    background: linear-gradient(
      135deg,
      rgba(var(--bg-raised-rgb), 0.6),
      rgba(var(--bg-card-rgb), 0.4)
    );
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: visible;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    cursor: pointer;
    position: relative;
  }

  .top-five-card:hover {
    border-color: var(--accent);
    box-shadow: 0 8px 24px rgba(var(--accent-rgb), 0.1);
  }

  .top-five-card.is-expanded {
    box-shadow: 0 12px 48px rgba(var(--accent-rgb), 0.15);
  }

  /* Collapsed state */
  .top-five-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    gap: 1rem;
  }

  .trigger-main {
    flex: 1;
    text-align: center;
  }

  .trigger-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-secondary);
    margin: 0;
  }

  .trigger-top {
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0.5rem 0 0 0;
  }

  .chevron {
    font-size: 1.5rem;
    color: var(--text-secondary);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  details[open] .chevron {
    transform: rotate(180deg);
  }

  /* Expanded state - pops out to the right */
  .top-five-expanded {
    top: 0;
    left: 0;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 1000;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(var(--bg-card-rgb), 0.95);
    backdrop-filter: blur(8px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  details[open] .top-five-expanded {
    opacity: 1;
    pointer-events: auto;
  }

  .table-header {
    padding: 1.5rem 1.5rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .table-header h2 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .table-wrapper {
    padding: 1.5rem;
    overflow-x: auto;
  }

  .top-five-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .top-five-table thead {
    border-bottom: 2px solid var(--border);
  }

  .top-five-table th {
    padding: 0.75rem;
    text-align: left;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--accent-dim);
    font-size: 0.7rem;
  }

  .rank-col {
    width: 60px;
  }

  .value-col {
    width: 80px;
    text-align: right;
  }

  .table-row {
    border-bottom: 1px solid var(--border-subtle);
    transition: all 0.2s;
  }

  .table-row:hover {
    background: rgba(var(--accent-rgb), 0.05);
  }

  .table-row:last-child {
    border-bottom: none;
  }

  .top-five-table td {
    padding: 1rem 0.75rem;
    vertical-align: middle;
  }

  .rank-cell {
    text-align: center;
    font-weight: 700;
  }

  .rank-badge {
    display: inline-block;
    font-size: 1.25rem;
  }

  .name-cell {
    font-weight: 500;
    color: var(--text-primary);
  }

  .name-link {
    color: var(--accent);
    text-decoration: none;
    transition: all 0.2s;
    font-weight: 600;
  }

  .name-link:hover {
    text-decoration: underline;
    opacity: 0.8;
  }

  .value-cell {
    text-align: right;
    color: var(--accent);
    font-weight: 700;
    font-family: "Courier New", monospace;
  }

  @media (max-width: 1200px) {
    .top-five-expanded {
      width: 500px;
    }
  }

  @media (max-width: 768px) {
    .top-five-expanded {
      position: fixed;
      top: 50%;
      left: 50%;
      width: calc(100vw - 2rem);
      max-width: 500px;
      transform: translate(-50%, -50%) scale(0.9);
    }

    details[open] .top-five-expanded {
      transform: translate(-50%, -50%) scale(1);
    }

    .top-five-table {
      font-size: 0.75rem;
    }

    .trigger-label {
      font-size: 0.65rem;
    }

    .trigger-top {
      font-size: 0.9rem;
    }
  }

  summary {
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary {
    height: 0%;
    overflow: hidden;
  }
</style>
