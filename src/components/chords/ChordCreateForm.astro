---
export type Props = {
  initial?: {
    slug?: string;
    displayName?: string;
    voicingLabel?: string;
    baseFret?: number;
    fingering?: number[];
    frets?: number[];
    notes?: string[];
    barre?: { finger: number; fret: number; strings: [number, number] };
    alternateNames?: string[];
  };
};

const { initial } = Astro.props;
---

<section class="create">
  <details id="chord-form-details">
    <summary class="create-summary">
      <div class="create-summary-content">
        <button class="create-reset-btn" type="button" id="form-reset-btn" title="Reset form">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
        </button>
        <span class="create-summary-text">Add a new chord voicing</span>
      </div>
    </summary>

    <form id="chord-create-form" class="form">
      <div class="row">
        <label>
          <span>Slug</span>
          <input name="slug" type="text" required value={initial?.slug || ""} placeholder="am7-1" />
        </label>
        <label>
          <span>Display name</span>
          <input name="displayName" type="text" required value={initial?.displayName || ""} placeholder="Am7" />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Voicing label</span>
          <input name="voicingLabel" type="text" required value={initial?.voicingLabel || ""} placeholder="E-shape barre, 5th fret" />
        </label>
        <label>
          <span>Base fret</span>
          <input name="baseFret" type="number" min="1" required value={initial?.baseFret || 1} />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Fingering (JSON)</span>
          <input name="fingering" type="text" required value={JSON.stringify(initial?.fingering || [0,0,0,0,0,0])} />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Frets (JSON)</span>
          <input name="frets" type="text" required value={JSON.stringify(initial?.frets || [-1,-1,-1,-1,-1,-1])} />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Notes (JSON)</span>
          <input name="notes" type="text" value={JSON.stringify(initial?.notes || [])} />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Alternate Names (JSON, optional)</span>
          <input name="alternateNames" type="text" value={initial?.alternateNames ? JSON.stringify(initial.alternateNames) : ""} placeholder='["E7sus", "E7s4"]' />
        </label>
      </div>

      <div class="row">
        <label class="grow">
          <span>Barre (JSON, optional)</span>
          <input name="barre" type="text" value={initial?.barre ? JSON.stringify(initial.barre) : ""} placeholder='{"finger":1,"fret":5,"strings":[1,6]}' />
        </label>
      </div>

      <div class="actions">
        <button type="submit">Save to Collection</button>
      </div>

      <p id="chord-create-status" class="status" aria-live="polite"></p>
    </form>
  </details>
</section>

<script>
  const form = document.getElementById("chord-create-form") as HTMLFormElement;
  const statusEl = document.getElementById("chord-create-status") as HTMLParagraphElement;
  const details = document.getElementById("chord-form-details") as HTMLDetailsElement;
  const resetBtn = document.getElementById("form-reset-btn");

  // --- 1. Prefill Listener (Catch events from ChordAnalyser) ---
  document.addEventListener("chord:create", (e: Event) => {
    const customEvent = e as CustomEvent<{ 
      displayName: string; 
      frets: number[]; 
      notes: string[]; 
      fingering?: number[];
      baseFret?: number;
    }>;
    
    const { displayName, frets, notes, fingering, baseFret } = customEvent.detail;

    // Map incoming data to form inputs
    const fields: Record<string, string> = {
      displayName: displayName,
      frets: JSON.stringify(frets),
      notes: JSON.stringify(notes),
      fingering: JSON.stringify(fingering || [0,0,0,0,0,0]),
      baseFret: String(baseFret || 1),
      // Auto-generate a slug if empty
      slug: displayName.toLowerCase().replace(/[^a-z0-9]/g, "") + "-0"
    };

    Object.entries(fields).forEach(([name, value]) => {
      const input = form.querySelector(`[name="${name}"]`) as HTMLInputElement;
      if (input) input.value = value;
    });

    // Expand the form so the user sees it's filled
    if (details) details.open = true;
    
    statusEl.style.color = "#d4bb88";
    statusEl.textContent = "Form prefilled from analyser.";
  });

  // --- 2. Save Listener (Send to API) ---
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    statusEl.style.color = "#d4bb88";
    statusEl.textContent = "Saving...";

    const formData = new FormData(form);
    const rawData = Object.fromEntries(formData.entries());

    try {
      const payload = {
        slug: rawData.slug,
        displayName: rawData.displayName,
        voicingLabel: rawData.voicingLabel,
        baseFret: parseInt(rawData.baseFret as string, 10),
        fingering: JSON.parse(rawData.fingering as string),
        frets: JSON.parse(rawData.frets as string),
        notes: JSON.parse(rawData.notes as string || "[]"),
        alternateNames: rawData.alternateNames ? JSON.parse(rawData.alternateNames as string) : undefined,
        barre: rawData.barre ? JSON.parse(rawData.barre as string) : undefined
      };

      const res = await fetch("/api/chords/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const result = await res.json();

      if (result.success) {
        statusEl.style.color = "#4ade80";
        statusEl.textContent = `Success: Saved ${result.id}.mdx`;
      } else {
        statusEl.style.color = "#f87171";
        statusEl.textContent = `Error: ${result.message}`;
      }
    } catch (err) {
      statusEl.style.color = "#f87171";
      statusEl.textContent = "Error parsing fields. Check your JSON format.";
    }
  });

  // Reset logic
  resetBtn?.addEventListener("click", () => {
     form.reset();
     statusEl.textContent = "";
  });
</script>

<style>
  /* Keep your existing CSS here */
  .create { border: 1px solid #3a300f; border-radius: 6px; background: #1a1508; color: #d4bb88; margin-bottom: 2rem; }
  .form { padding: 20px; display: grid; gap: 1rem; }
  .row { display: flex; gap: 1rem; flex-wrap: wrap; }
  .grow { flex: 1; }
  label { display: grid; gap: 0.5rem; font-size: 0.8rem; }
  input { background: #000; border: 1px solid #3a300f; color: #fff; padding: 0.5rem; border-radius: 4px; }
  button { background: #e8a030; color: #000; border: none; padding: 0.6rem 1.2rem; border-radius: 4px; font-weight: bold; cursor: pointer; }
  .status { font-family: monospace; font-size: 0.85rem; margin-top: 1rem; }

  .create {
    margin-bottom: var(--space-8);
    border: 1px solid #3a300f;
    border-radius: 6px;
    background: #1a1508;
    color: #d4bb88;
    font-family: "Courier New", "Courier", monospace;
    overflow: hidden;
  }

  .create-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px 6px;
    border-bottom: 1px solid #3a300f;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .create-summary::-webkit-details-marker {
    display: none;
  }

  .create-summary-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .create-summary-text {
    font-family: "Courier New", Courier, monospace;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: .15em;
    color: #d4bb88;
    text-align: center;
    text-transform: uppercase;
    flex: 1;
  }

  .create-reset-btn {
    background: transparent;
    border: 1px solid #3a300f;
    border-radius: 50%;
    color: #7a6a44;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }
  
  .create-reset-btn:hover {
    color: #e8a030;
    border-color: #c8922a;
  }

  .create-toggle-btn {
    background: transparent;
    border: 1px solid #3a300f;
    border-radius: 50%;
    color: #7a6a44;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
    flex-shrink: 0;
  }
  
  .create-toggle-btn:hover {
    color: #e8a030;
    border-color: #c8922a;
  }
  
  details[open] .create-toggle-btn {
    transform: rotate(180deg);
  }

  .form {
    margin-top: var(--space-4);
    padding: 14px 20px 20px;
    display: grid;
    gap: var(--space-4);
    background: var(--surface-subtle);
    border-top: 1px solid #3a300f;
  }

  .row {
    display: flex;
    gap: var(--space-4);
    align-items: flex-end;
    flex-wrap: wrap;
  }

  label {
    display: grid;
    gap: var(--space-2);
    min-width: 220px;
  }

  .grow {
    flex: 1;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  textarea {
    font-family: var(--font-mono);
    resize: vertical;
  }

  .actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }

  button {
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--accent);
    color: white;
    font-weight: 700;
    cursor: pointer;
  }

  .status {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .output span {
    font-weight: 700;
  }
</style>
