---
/**
 * NewContentSidebar.astro
 * 
 * Reusable sidebar component for creating new content with form + editor.
 * Opens from the right side with a form that generates frontmatter.
 */

interface Props {
  contentType: string;
  title: string;
}

const { contentType, title } = Astro.props;
---

<div class="new-content-sidebar" data-content-type={contentType} style="display: none;">
  <div class="sidebar-overlay"></div>
  <div class="sidebar-panel">
    <div class="sidebar-header">
      <h2>{title}</h2>
      <button class="btn-close" type="button" aria-label="Close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="sidebar-content">
      <!-- Form Section -->
      <div class="form-section">
        <h3>Content Details</h3>
        <form class="content-form">
          <slot name="form" />
          
          <div class="form-actions">
            <button type="button" class="btn-generate">Generate Preview</button>
          </div>
        </form>
      </div>

      <!-- Editor Section -->
      <div class="editor-section">
        <div class="editor-tabs">
          <button type="button" class="tab-btn active" data-tab="editor">Editor</button>
          <button type="button" class="tab-btn" data-tab="preview">Preview</button>
        </div>

        <div class="tab-content active" data-tab-content="editor">
          <textarea 
            class="content-textarea" 
            placeholder="Content will be generated from the form above..."
            spellcheck="false"
          ></textarea>
        </div>

        <div class="tab-content" data-tab-content="preview">
          <div class="content-preview">
            <p class="empty-state">Preview will appear here after generating...</p>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="sidebar-footer">
        <button type="button" class="btn-save-download">Download File</button>
        <button type="button" class="btn-cancel-sidebar">Cancel</button>
      </div>
    </div>
  </div>
</div>

<style>
  .new-content-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
  }

  .sidebar-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .sidebar-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 90%;
    max-width: 800px;
    background: var(--bg-card-subtle);
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    animation: slideIn 0.3s ease;
  }

  @keyframes slideIn {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .sidebar-header {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--accent-dark);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--accent-subtle);
  }

  .sidebar-header h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
  }

  .btn-close {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: #666;
    transition: color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-close:hover {
    color: #000;
  }

  .sidebar-content {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .form-section {
    padding: 2rem;
    border-bottom: 1px solid var(--accent-dim);
    background: var(--bg-card-subtle);
  }

  .form-section h3 {
    margin: 0 0 1.5rem 0;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .content-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .content-form :global(.form-group) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .content-form :global(label) {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .content-form :global(input),
  .content-form :global(select),
  .content-form :global(textarea) {
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.875rem;
    font-family: inherit;
    background: var(--bg-raised);
  }

  .content-form :global(input:focus),
  .content-form :global(select:focus),
  .content-form :global(textarea:focus) {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(33, 150, 243, 0.1);
  }

  .content-form :global(textarea) {
    min-height: 80px;
    resize: vertical;
    font-family: inherit;
  }

  .content-form :global(.form-hint) {
    font-size: 0.75rem;
    color: #666;
    margin-top: -0.25rem;
  }

  .form-actions {
    margin-top: 1rem;
  }

  .btn-generate {
    padding: 0.75rem 1.5rem;
    background: #2196f3;
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    font-size: 0.875rem;
  }

  .btn-generate:hover {
    background: #1976d2;
  }

  .editor-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 400px;
  }

  .editor-tabs {
    display: flex;
    border-bottom: 1px dotted var(--accent);
    background: var(--blue-subtle);
  }

  .tab-btn {
    padding: 1rem 2rem;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .tab-btn:hover {
    color: #333;
    background: #ebebeb;
  }

  .tab-btn.active {
    color: var(--text-primary);
    background: var(--accent-dark);
  }

  .tab-content {
    display: none;
    flex: 1;
    overflow: hidden;
  }

  .tab-content.active {
    display: flex;
    flex-direction: column;
  }

  .content-textarea {
    flex: 1;
    padding: 1.5rem;
    border: none;
    resize: none;
    font-family: 'Courier New', Courier, monospace;
    font-size: 14px;
    line-height: 1.6;
    overflow-y: auto;
  }

  .content-textarea:focus {
    outline: none;
  }

  .content-preview {
    flex: 1;
    padding: 2rem;
    overflow-y: auto;
    background: #fafafa;
  }

  .empty-state {
    color: #999;
    font-style: italic;
    text-align: center;
    padding: 2rem;
  }

  .content-preview :global(h1) { font-size: 2em; margin: 0.67em 0; }
  .content-preview :global(h2) { font-size: 1.5em; margin: 0.75em 0; }
  .content-preview :global(h3) { font-size: 1.17em; margin: 0.83em 0; }
  .content-preview :global(p) { margin: 1em 0; }
  .content-preview :global(code) { 
    background: #f5f5f5; 
    padding: 0.125rem 0.375rem; 
    border-radius: 3px;
  }

  .sidebar-footer {
    padding: .5rem .5rem;
    border-top: 1px solid var(--accent-dark);
    display: flex;
    gap: 1rem;
    background: var(--blue-subtle);
  }

  .btn-save-download,
  .btn-cancel-sidebar {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 0.875rem;
  }

  .btn-save-download {
    background: var(--accent-dark);
    color: var(--text-primary);
    flex: 1;
  }

  .btn-save-download:hover {
    background: var(--accent-dim);
  }

  .btn-save-download:disabled {
    background: #9e9e9e;
    cursor: not-allowed;
  }

  .btn-cancel-sidebar {
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid transparent;
  }

  .btn-cancel-sidebar:hover {
    background: var(--bg-raised);
    border: 1px solid var(--accent-dark);
  }

  @media (max-width: 768px) {
    .sidebar-panel {
      width: 100%;
      max-width: none;
    }
  }
</style>

<script>
  class NewContentSidebar {
    private sidebar: HTMLElement;
    private overlay: HTMLElement;
    private closeBtn: HTMLButtonElement;
    private cancelBtn: HTMLButtonElement;
    private generateBtn: HTMLButtonElement;
    private saveBtn: HTMLButtonElement;
    private textarea: HTMLTextAreaElement;
    private preview: HTMLElement;
    private form: HTMLFormElement;
    private tabBtns: NodeListOf<HTMLButtonElement>;
    private tabContents: NodeListOf<HTMLElement>;

    constructor(sidebar: HTMLElement) {
      this.sidebar = sidebar;
      this.overlay = sidebar.querySelector('.sidebar-overlay')!;
      this.closeBtn = sidebar.querySelector('.btn-close')!;
      this.cancelBtn = sidebar.querySelector('.btn-cancel-sidebar')!;
      this.generateBtn = sidebar.querySelector('.btn-generate')!;
      this.saveBtn = sidebar.querySelector('.btn-save-download')!;
      this.textarea = sidebar.querySelector('.content-textarea')!;
      this.preview = sidebar.querySelector('.content-preview')!;
      this.form = sidebar.querySelector('.content-form')!;
      this.tabBtns = sidebar.querySelectorAll('.tab-btn');
      this.tabContents = sidebar.querySelectorAll('.tab-content');

      this.init();
    }

    private init() {
      // Close handlers
      this.closeBtn.addEventListener('click', () => this.close());
      this.cancelBtn.addEventListener('click', () => this.close());
      this.overlay.addEventListener('click', () => this.close());

      // ESC key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.sidebar.style.display !== 'none') {
          this.close();
        }
      });

      // Tab switching
      this.tabBtns.forEach(btn => {
        btn.addEventListener('click', () => this.switchTab(btn.dataset.tab!));
      });

      // Generate button
      this.generateBtn.addEventListener('click', () => this.generateContent());

      // Save/Download button
      this.saveBtn.addEventListener('click', () => this.downloadFile());

      // Live preview update
      this.textarea.addEventListener('input', () => this.updatePreview());
    }

    private switchTab(tabName: string) {
      this.tabBtns.forEach(btn => {
        btn.classList.toggle('active', btn.dataset.tab === tabName);
      });
      this.tabContents.forEach(content => {
        content.classList.toggle('active', content.dataset.tabContent === tabName);
      });
    }

    private generateContent() {
      // Emit event for parent to handle form data conversion
      const event = new CustomEvent('generate-content', {
        detail: { form: this.form },
        bubbles: true
      });
      this.sidebar.dispatchEvent(event);
    }

    private updatePreview() {
      const content = this.textarea.value;
      if (!content.trim()) {
        this.preview.innerHTML = '<p class="empty-state">Preview will appear here after generating...</p>';
        return;
      }

      // Simple markdown rendering
      let html = content
        .replace(/&/g, '&')
        .replace(/</g, '<')
        .replace(/>/g, '>')
        .replace(/^### (.*$)/gim, '<h3>$1</h3>')
        .replace(/^## (.*$)/gim, '<h2>$1</h2>')
        .replace(/^# (.*$)/gim, '<h1>$1</h1>')
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/`(.*?)`/g, '<code>$1</code>')
        .replace(/\n\n/g, '</p><p>')
        .replace(/\n/g, '<br>');

      this.preview.innerHTML = '<p>' + html + '</p>';
    }

    private downloadFile() {
      const content = this.textarea.value;
      if (!content.trim()) {
        alert('Please generate content first');
        return;
      }

      // Emit event for parent to handle download
      const event = new CustomEvent('download-content', {
        detail: { content },
        bubbles: true
      });
      this.sidebar.dispatchEvent(event);
    }

      public open() {
        this.sidebar.style.display = 'block';
        document.body.style.overflow = 'hidden';
      }
  
      public close() {
        this.sidebar.style.display = 'none';
        document.body.style.overflow = '';
        this.form.reset();
        this.textarea.value = '';
        this.preview.innerHTML = '<p class="empty-state">Preview will appear here after generating...</p>';
        this.switchTab('editor');
      }
  
      public setContent(content: string) {
        this.textarea.value = content;
        this.updatePreview();
        this.switchTab('preview');
      }
    }
  
    // Initialize all sidebars and expose methods
    document.addEventListener('DOMContentLoaded', () => {
      const sidebars = document.querySelectorAll('.new-content-sidebar');
      sidebars.forEach(sidebarEl => {
        const instance = new NewContentSidebar(sidebarEl as HTMLElement);
        // Expose methods on the element for external access
        (sidebarEl as any).open = () => instance.open();
        (sidebarEl as any).close = () => instance.close();
        (sidebarEl as any).setContent = (content: string) => instance.setContent(content);
      });
    });
</script>