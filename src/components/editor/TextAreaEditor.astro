---
/**
 * TextAreaEditor.astro
 * 
 * Reusable side-by-side markdown editor with live preview.
 * Similar to scene editor but without screenplay-specific formatting.
 */

interface Props {
  initialContent?: string;
  showFormatGuide?: boolean;
  formatGuideContent?: string;
}

const { 
  initialContent = '', 
  showFormatGuide = false,
  formatGuideContent = ''
} = Astro.props;
---

<div class="text-editor-container">
  <!-- Shared Header -->
  <div class="editor-header">
    <h3>Edit Content</h3>
    <div class="editor-actions">
      <button class="btn-save" type="button">Save</button>
      <button class="btn-cancel" type="button">Cancel</button>
    </div>
  </div>
  
  {showFormatGuide && formatGuideContent && (
    <div class="editor-hints">
      <details>
        <summary>Format Guide</summary>
        <div class="hints-content" set:html={formatGuideContent} />
      </details>
    </div>
  )}

  <!-- Side-by-side Editor and Preview -->
  <div class="editor-preview-grid">
    <!-- Editor Panel -->
    <div class="editor-panel">
      <div class="panel-label">Markdown</div>
      <textarea 
        class="editor-textarea"
        spellcheck="false"
        placeholder="Enter your content here..."
      >{initialContent}</textarea>
    </div>

    <!-- Resize Handle -->
    <div class="resize-handle" aria-hidden="true"></div>

    <!-- Preview Panel -->
    <div class="preview-panel">
      <div class="panel-label">Preview</div>
      <div class="preview-content">
        <!-- Preview will be rendered here -->
      </div>
    </div>
  </div>
</div>

<style>
  .text-editor-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: white;
    border-radius: 8px;
    overflow: hidden;
  }

  .editor-header {
    padding: 1rem 1.5rem;
    border-bottom: 2px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f9f9f9;
    flex-shrink: 0;
  }

  .editor-header h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .editor-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn-save,
  .btn-cancel {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 0.875rem;
  }

  .btn-save {
    background: #2e7d32;
    color: white;
  }

  .btn-save:hover {
    background: #1b5e20;
  }

  .btn-save:disabled {
    background: #9e9e9e;
    cursor: not-allowed;
  }

  .btn-cancel {
    background: #e0e0e0;
    color: #333;
  }

  .btn-cancel:hover {
    background: #d0d0d0;
  }

  .editor-hints {
    padding: 0.75rem 1.5rem;
    background: #fffbf0;
    border-bottom: 1px solid #f0e6d2;
    flex-shrink: 0;
  }

  .editor-hints details {
    cursor: pointer;
  }

  .editor-hints summary {
    font-weight: 600;
    color: #856404;
    user-select: none;
    font-size: 0.875rem;
  }

  .hints-content {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: #666;
  }

  .editor-preview-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  .editor-panel,
  .preview-panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 200px;
  }

  .panel-label {
    padding: 0.5rem 1rem;
    background: #f5f5f5;
    border-bottom: 1px solid #e0e0e0;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #666;
  }

  .editor-textarea {
    flex: 1;
    padding: 1.5rem;
    border: none;
    resize: none;
    font-family: 'Courier New', Courier, monospace;
    font-size: 14px;
    line-height: 1.6;
    overflow-y: auto;
    background: white;
  }

  .editor-textarea:focus {
    outline: none;
  }

  .preview-content {
    flex: 1;
    padding: 1.5rem;
    overflow-y: auto;
    background: #fafafa;
    font-size: 14px;
    line-height: 1.6;
  }

  .preview-content :global(h1) { font-size: 2em; margin: 0.67em 0; }
  .preview-content :global(h2) { font-size: 1.5em; margin: 0.75em 0; }
  .preview-content :global(h3) { font-size: 1.17em; margin: 0.83em 0; }
  .preview-content :global(h4) { font-size: 1em; margin: 1em 0; }
  .preview-content :global(h5) { font-size: 0.83em; margin: 1.17em 0; }
  .preview-content :global(h6) { font-size: 0.67em; margin: 1.33em 0; }
  .preview-content :global(p) { margin: 1em 0; }
  .preview-content :global(ul), .preview-content :global(ol) { margin: 1em 0; padding-left: 2em; }
  .preview-content :global(code) { 
    background: #f5f5f5; 
    padding: 0.125rem 0.375rem; 
    border-radius: 3px;
    font-family: 'Courier New', monospace;
  }
  .preview-content :global(pre) {
    background: #f5f5f5;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
  }
  .preview-content :global(blockquote) {
    border-left: 4px solid #ddd;
    padding-left: 1rem;
    margin: 1em 0;
    color: #666;
  }

  .resize-handle {
    width: 8px;
    background: #e0e0e0;
    cursor: col-resize;
    position: relative;
    transition: background 0.2s;
  }

  .resize-handle:hover,
  .resize-handle.dragging {
    background: #2196f3;
  }

  .resize-handle::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 2px;
    height: 40px;
    background: rgba(255, 255, 255, 0.5);
    border-radius: 1px;
  }

  @media (max-width: 900px) {
    .editor-preview-grid {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto 1fr;
    }

    .resize-handle {
      width: 100%;
      height: 8px;
      cursor: row-resize;
    }

    .resize-handle::before {
      width: 40px;
      height: 2px;
    }
  }
</style>

<script>
  class TextAreaEditor {
    private textarea: HTMLTextAreaElement;
    private preview: HTMLElement;
    private saveBtn: HTMLButtonElement;
    private cancelBtn: HTMLButtonElement;
    private container: HTMLElement;
    private resizeHandle: HTMLElement;
    private editorPanel: HTMLElement;
    private initialContent: string;
    private isDragging = false;
    private dragStartX = 0;
    private dragStartWidth = 0;

    constructor(container: HTMLElement) {
      this.container = container;
      this.textarea = container.querySelector('.editor-textarea')!;
      this.preview = container.querySelector('.preview-content')!;
      this.saveBtn = container.querySelector('.btn-save')!;
      this.cancelBtn = container.querySelector('.btn-cancel')!;
      this.resizeHandle = container.querySelector('.resize-handle')!;
      this.editorPanel = container.querySelector('.editor-panel')!;
      this.initialContent = this.textarea.value;

      this.init();
    }

    private init() {
      // Update preview on input
      this.textarea.addEventListener('input', () => this.updatePreview());
      
      // Save button
      this.saveBtn.addEventListener('click', () => this.handleSave());
      
      // Cancel button
      this.cancelBtn.addEventListener('click', () => this.handleCancel());

      // Resize handle
      this.setupResize();

      // Sync scrolling
      this.setupScrollSync();

      // Initial preview
      this.updatePreview();
    }

    private setupResize() {
      this.resizeHandle.addEventListener('mousedown', (e: MouseEvent) => {
        this.isDragging = true;
        this.dragStartX = e.clientX;
        this.dragStartWidth = this.editorPanel.getBoundingClientRect().width;
        this.resizeHandle.classList.add('dragging');
        document.body.style.cursor = 'col-resize';
        document.body.style.userSelect = 'none';
      });

      document.addEventListener('mousemove', (e: MouseEvent) => {
        if (!this.isDragging) return;
        const delta = e.clientX - this.dragStartX;
        const newWidth = Math.max(200, this.dragStartWidth + delta);
        this.editorPanel.style.width = `${newWidth}px`;
        this.editorPanel.style.flex = 'none';
      });

      document.addEventListener('mouseup', () => {
        if (!this.isDragging) return;
        this.isDragging = false;
        this.resizeHandle.classList.remove('dragging');
        document.body.style.cursor = '';
        document.body.style.userSelect = '';
      });
    }

    private setupScrollSync() {
      let syncingScroll = false;

      this.textarea.addEventListener('scroll', () => {
        if (syncingScroll) return;
        syncingScroll = true;
        const ratio = this.textarea.scrollTop / (this.textarea.scrollHeight - this.textarea.clientHeight);
        this.preview.scrollTop = ratio * (this.preview.scrollHeight - this.preview.clientHeight);
        syncingScroll = false;
      });

      this.preview.addEventListener('scroll', () => {
        if (syncingScroll) return;
        syncingScroll = true;
        const ratio = this.preview.scrollTop / (this.preview.scrollHeight - this.preview.clientHeight);
        this.textarea.scrollTop = ratio * (this.textarea.scrollHeight - this.textarea.clientHeight);
        syncingScroll = false;
      });
    }

    private updatePreview() {
      const content = this.textarea.value;
      // Simple markdown-like rendering
      const html = this.renderMarkdown(content);
      this.preview.innerHTML = html;
    }

    private renderMarkdown(text: string): string {
      if (!text.trim()) return '<p class="empty-preview">Preview will appear here...</p>';

      let html = text;
      
      // Escape HTML
      html = html.replace(/&/g, '&')
                 .replace(/</g, '<')
                 .replace(/>/g, '>');

      // Headers
      html = html.replace(/^### (.*$)/gim, '<h3>$1</h3>');
      html = html.replace(/^## (.*$)/gim, '<h2>$1</h2>');
      html = html.replace(/^# (.*$)/gim, '<h1>$1</h1>');

      // Bold
      html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
      
      // Italic
      html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
      
      // Code
      html = html.replace(/`(.*?)`/g, '<code>$1</code>');
      
      // Line breaks
      html = html.replace(/\n\n/g, '</p><p>');
      html = html.replace(/\n/g, '<br>');
      
      // Wrap in paragraph
      html = '<p>' + html + '</p>';

      return html;
    }

    private handleSave() {
      const content = this.textarea.value;
      
      // Emit custom event for parent to handle
      const event = new CustomEvent('editor-save', {
        detail: { content },
        bubbles: true
      });
      this.container.dispatchEvent(event);
    }

    private handleCancel() {
      this.textarea.value = this.initialContent;
      this.updatePreview();
      
      // Emit custom event for parent to handle
      const event = new CustomEvent('editor-cancel', {
        bubbles: true
      });
      this.container.dispatchEvent(event);
    }

    public getContent(): string {
      return this.textarea.value;
    }

    public setContent(content: string) {
      this.textarea.value = content;
      this.updatePreview();
    }
  }

  // Initialize editor
  document.addEventListener('DOMContentLoaded', () => {
    const editorContainers = document.querySelectorAll('.text-editor-container');
    editorContainers.forEach(container => {
      new TextAreaEditor(container as HTMLElement);
    });
  });
</script>