---
/**
 * NewProjectButton.astro
 * 
 * Button and sidebar for creating new projects.
 */

import NewContentSidebar from './NewContentSidebar.astro';
---

<button class="new-project-btn" type="button">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M12 5v14M5 12h14"/>
  </svg>
  New Project
</button>

<NewContentSidebar contentType="project" title="Create New Project">
  <div slot="form">
    <div class="form-group">
      <label for="project-title">Title *</label>
      <input 
        type="text" 
        id="project-title" 
        name="title" 
        required 
        placeholder="e.g., Her Majesty's Displeasure"
      />
      <span class="form-hint">The display title of your project</span>
    </div>

    <div class="form-group">
      <label for="project-slug">Slug</label>
      <input 
        type="text" 
        id="project-slug" 
        name="slug" 
        placeholder="Auto-generated from title"
      />
      <span class="form-hint">URL-friendly identifier (leave blank to auto-generate)</span>
    </div>

    <div class="form-group">
      <label for="project-type">Type *</label>
      <select id="project-type" name="type" required>
        <option value="">Select type...</option>
        <option value="tv-series">TV Series</option>
        <option value="film">Film</option>
        <option value="book">Book</option>
        <option value="short">Short Story</option>
        <option value="other">Other</option>
      </select>
    </div>

    <div class="form-group">
      <label for="project-description">Description</label>
      <textarea 
        id="project-description" 
        name="description" 
        rows="3"
        placeholder="Brief description of the project..."
      ></textarea>
    </div>

    <div class="form-group">
      <label for="project-genre">Genre</label>
      <input 
        type="text" 
        id="project-genre" 
        name="genre" 
        placeholder="e.g., Drama, Thriller, Comedy"
      />
    </div>

    <div class="form-group">
      <label for="project-status">Status</label>
      <select id="project-status" name="status">
        <option value="in-development">In Development</option>
        <option value="writing">Writing</option>
        <option value="revision">Revision</option>
        <option value="complete">Complete</option>
        <option value="archived">Archived</option>
      </select>
    </div>

    <div class="form-group">
      <label for="project-year">Year</label>
      <input 
        type="number" 
        id="project-year" 
        name="year" 
        min="1900" 
        max="2100"
        placeholder="e.g., 2024"
      />
    </div>

    <div class="form-group">
      <label for="project-episodes">Number of Episodes (for TV series)</label>
      <input 
        type="number" 
        id="project-episodes" 
        name="episodeCount" 
        min="1"
        placeholder="e.g., 6"
      />
    </div>
  </div>
</NewContentSidebar>

<style>
  .new-project-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: #2196f3;
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 2px 4px rgba(33, 150, 243, 0.3);
  }

  .new-project-btn:hover {
    background: #1976d2;
    box-shadow: 0 4px 8px rgba(33, 150, 243, 0.4);
    transform: translateY(-1px);
  }

  .new-project-btn:active {
    transform: translateY(0);
  }

  .new-project-btn svg {
    flex-shrink: 0;
  }
</style>

<script>
  import { createMDXContent, titleToSlug, type FrontmatterField } from '../../utils/editor/frontmatterUtils';

  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('.new-project-btn') as HTMLButtonElement;
    const sidebar = document.querySelector('[data-content-type="project"]') as HTMLElement & {
      open?: () => void;
      setContent?: (content: string) => void;
    };

    if (!btn || !sidebar) return;

    // Open sidebar
    btn.addEventListener('click', () => {
      if (sidebar.open) sidebar.open();
    });

    // Auto-generate slug from title
    const titleInput = document.getElementById('project-title') as HTMLInputElement;
    const slugInput = document.getElementById('project-slug') as HTMLInputElement;

    titleInput?.addEventListener('input', () => {
      if (!slugInput.value || slugInput.dataset.autoGenerated === 'true') {
        slugInput.value = titleToSlug(titleInput.value);
        slugInput.dataset.autoGenerated = 'true';
      }
    });

    slugInput?.addEventListener('input', () => {
      if (slugInput.value) {
        slugInput.dataset.autoGenerated = 'false';
      }
    });

    // Generate content from form
    sidebar.addEventListener('generate-content', ((e: CustomEvent) => {
      const form = e.detail.form as HTMLFormElement;
      const formData = new FormData(form);

      const fields: FrontmatterField[] = [
        { name: 'title', value: formData.get('title') as string, type: 'string' },
        { name: 'slug', value: (formData.get('slug') as string) || titleToSlug(formData.get('title') as string), type: 'string' },
        { name: 'type', value: formData.get('type') as string, type: 'string' },
        { name: 'description', value: formData.get('description') as string, type: 'string' },
        { name: 'genre', value: formData.get('genre') as string, type: 'string' },
        { name: 'status', value: formData.get('status') as string, type: 'string' },
      ];

      const year = formData.get('year');
      if (year) {
        fields.push({ name: 'year', value: parseInt(year as string), type: 'number' });
      }

      const episodeCount = formData.get('episodeCount');
      if (episodeCount) {
        fields.push({ name: 'episodeCount', value: parseInt(episodeCount as string), type: 'number' });
      }

      const content = createMDXContent(fields, '\n## Overview\n\nAdd your project overview here...\n');
      
      if (sidebar.setContent) sidebar.setContent(content);
    }) as EventListener);

    // Download file
    sidebar.addEventListener('download-content', ((e: CustomEvent) => {
      const content = e.detail.content;
      const titleInput = document.getElementById('project-title') as HTMLInputElement;
      const slugInput = document.getElementById('project-slug') as HTMLInputElement;
      
      const filename = slugInput.value || titleToSlug(titleInput.value) || 'new-project';
      
      const blob = new Blob([content], { type: 'text/markdown' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${filename}.mdx`;
      a.click();
      URL.revokeObjectURL(url);

      // Show success message
      const saveBtn = sidebar.querySelector('.btn-save-download') as HTMLButtonElement;
      if (saveBtn) {
        const originalText = saveBtn.textContent;
        saveBtn.textContent = 'Downloaded!';
        saveBtn.disabled = true;
        setTimeout(() => {
          saveBtn.textContent = originalText;
          saveBtn.disabled = false;
        }, 2000);
      }
    }) as EventListener);
  });
</script>