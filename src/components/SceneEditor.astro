---
/**
 * SceneEditor.astro
 * 
 * Side-by-side markdown editor with live preview for screenplay scenes.
 * Supports the shorthand screenplay format from remark-screenplay plugin.
 */

interface Props {
  sceneId: string;
  initialContent: string;
  sceneData: any;
}

const { sceneId, initialContent, sceneData } = Astro.props;
---

<div class="scene-editor" data-scene-id={sceneId}>
  <div class="editor-container">
    <!-- Editor Panel -->
    <div class="editor-panel">
      <div class="editor-header">
        <h3>Edit Scene</h3>
        <div class="editor-actions">
          <button class="btn-save" type="button">Save Changes</button>
          <button class="btn-cancel" type="button">Cancel</button>
        </div>
      </div>
      
      <div class="editor-hints">
        <details>
          <summary>Screenplay Format Guide</summary>
          <div class="hints-content">
            <h4>Shorthand Syntax:</h4>
            <ul>
              <li><code>s-</code> or <code>scene-</code> → Scene heading (INT./EXT.)</li>
              <li><code>a-</code> or <code>action-</code> → Action/description</li>
              <li><code>c-</code> or <code>character-</code> → Character name</li>
              <li><code>d-</code> or <code>dialogue-</code> → Dialogue</li>
              <li><code>p-</code> or <code>parenthetical-</code> → Parenthetical</li>
              <li><code>t-</code> or <code>transition-</code> → Transition</li>
              <li><code>ab-</code> or <code>act-break-</code> → Act break</li>
            </ul>
            <h4>Implicit Format (in scene files):</h4>
            <ul>
              <li><strong>ALL CAPS</strong> → Character name</li>
              <li><strong>(text in parens)</strong> → Parenthetical</li>
              <li><strong>INT./EXT.</strong> → Scene heading</li>
              <li>Regular text → Action or dialogue (context-dependent)</li>
            </ul>
            <h4>Inline Markers:</h4>
            <ul>
              <li><code>//Name</code> → Forces uppercase (e.g., <code>//john</code> → JOHN)</li>
            </ul>
          </div>
        </details>
      </div>

      <textarea 
        class="editor-textarea"
        spellcheck="false"
        data-initial-content={initialContent}
      >{initialContent}</textarea>
    </div>

    <!-- Preview Panel -->
    <div class="preview-panel">
      <div class="preview-header">
        <h3>Preview</h3>
      </div>
      <div class="preview-content screenplay-root">
        <!-- Preview will be rendered here -->
      </div>
    </div>
  </div>
</div>

<style>
  .scene-editor {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .editor-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    width: 100%;
    max-width: 1800px;
    height: 90vh;
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
  }

  .editor-panel,
  .preview-panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .editor-header,
  .preview-header {
    padding: 1rem 1.5rem;
    border-bottom: 2px solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f9f9f9;
  }

  .editor-header h3,
  .preview-header h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .editor-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn-save,
  .btn-cancel {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-save {
    background: #2e7d32;
    color: white;
  }

  .btn-save:hover {
    background: #1b5e20;
  }

  .btn-cancel {
    background: #e0e0e0;
    color: #333;
  }

  .btn-cancel:hover {
    background: #d0d0d0;
  }

  .editor-hints {
    padding: 0.75rem 1.5rem;
    background: #fffbf0;
    border-bottom: 1px solid #f0e6d2;
  }

  .editor-hints details {
    cursor: pointer;
  }

  .editor-hints summary {
    font-weight: 600;
    color: #856404;
    user-select: none;
  }

  .hints-content {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: #666;
  }

  .hints-content h4 {
    margin: 0.75rem 0 0.5rem 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: #333;
  }

  .hints-content ul {
    margin: 0.5rem 0;
    padding-left: 1.5rem;
  }

  .hints-content li {
    margin: 0.25rem 0;
  }

  .hints-content code {
    background: #f5f5f5;
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
    font-family: 'Courier New', monospace;
    font-size: 0.875em;
  }

  .editor-textarea {
    flex: 1;
    padding: 1.5rem;
    border: none;
    resize: none;
    font-family: 'Courier New', Courier, monospace;
    font-size: 14px;
    line-height: 1.6;
    overflow-y: auto;
  }

  .editor-textarea:focus {
    outline: none;
  }

  .preview-content {
    flex: 1;
    padding: 2rem;
    overflow-y: auto;
    background: #f5f5f5;
  }

  /* PDF-like styling for preview */
  .preview-content {
    display: flex;
    justify-content: center;
  }

  .preview-content :global(.screenplay-page) {
    width: 8.5in;
    min-height: 11in;
    background: white;
    padding: 1in;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    margin: 0 auto;
  }

  @media (max-width: 1200px) {
    .editor-container {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
    }
  }
</style>

<script>
  class SceneEditor {
    private editor: HTMLTextAreaElement;
    private preview: HTMLElement;
    private saveBtn: HTMLButtonElement;
    private cancelBtn: HTMLButtonElement;
    private container: HTMLElement;
    private sceneId: string;
    private initialContent: string;

    constructor(container: HTMLElement) {
      this.container = container;
      this.sceneId = container.dataset.sceneId || '';
      this.editor = container.querySelector('.editor-textarea')!;
      this.preview = container.querySelector('.preview-content')!;
      this.saveBtn = container.querySelector('.btn-save')!;
      this.cancelBtn = container.querySelector('.btn-cancel')!;
      this.initialContent = this.editor.dataset.initialContent || '';

      this.init();
    }

    private init() {
      // Update preview on input
      this.editor.addEventListener('input', () => this.updatePreview());
      
      // Save button
      this.saveBtn.addEventListener('click', () => this.save());
      
      // Cancel button
      this.cancelBtn.addEventListener('click', () => this.close());
      
      // ESC key to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') this.close();
      });

      // Click outside to close
      this.container.addEventListener('click', (e) => {
        if (e.target === this.container) this.close();
      });

      // Initial preview
      this.updatePreview();
    }

    private updatePreview() {
      const content = this.editor.value;
      const html = this.renderScreenplay(content);
      this.preview.innerHTML = `<div class="screenplay-page">${html}</div>`;
    }

    private renderScreenplay(markdown: string): string {
      // Simple client-side rendering of screenplay format
      const lines = markdown.split('\n');
      let html = '';
      let inDialogue = false;
      let currentCharacter = '';

      for (const line of lines) {
        const trimmed = line.trim();
        
        if (!trimmed) {
          html += '<p></p>';
          inDialogue = false;
          continue;
        }

        // Scene heading
        if (trimmed.match(/^(s-|scene-)/i)) {
          const text = trimmed.replace(/^(s-|scene-)/i, '').trim();
          html += `<div class="scene">${this.escapeHtml(text)}</div>`;
          inDialogue = false;
        }
        // Action
        else if (trimmed.match(/^(a-|action-)/i)) {
          const text = trimmed.replace(/^(a-|action-)/i, '').trim();
          html += `<div class="action">${this.escapeHtml(text)}</div>`;
          inDialogue = false;
        }
        // Character
        else if (trimmed.match(/^(c-|character-)/i)) {
          const text = trimmed.replace(/^(c-|character-)/i, '').trim();
          html += `<div class="character">${this.escapeHtml(text.toUpperCase())}</div>`;
          currentCharacter = text.toUpperCase();
          inDialogue = true;
        }
        // Dialogue
        else if (trimmed.match(/^(d-|dialogue-)/i)) {
          const text = trimmed.replace(/^(d-|dialogue-)/i, '').trim();
          html += `<div class="dialogue">${this.escapeHtml(text)}</div>`;
        }
        // Parenthetical
        else if (trimmed.match(/^(p-|parenthetical-)/i)) {
          const text = trimmed.replace(/^(p-|parenthetical-)/i, '').trim();
          const cleaned = text.replace(/^\(|\)$/g, '');
          html += `<div class="parenthetical">(${this.escapeHtml(cleaned)})</div>`;
        }
        // Transition
        else if (trimmed.match(/^(t-|transition-)/i)) {
          const text = trimmed.replace(/^(t-|transition-)/i, '').trim();
          html += `<div class="transition">${this.escapeHtml(text)}</div>`;
          inDialogue = false;
        }
        // Implicit formats
        else if (trimmed.match(/^(INT\.|EXT\.|INT\/EXT)/i)) {
          html += `<div class="scene">${this.escapeHtml(trimmed)}</div>`;
          inDialogue = false;
        }
        else if (trimmed.match(/^[A-Z][A-Z0-9 .,'()\-\/&]+$/) && !trimmed.match(/[a-z]/)) {
          html += `<div class="character">${this.escapeHtml(trimmed)}</div>`;
          currentCharacter = trimmed;
          inDialogue = true;
        }
        else if (trimmed.match(/^\(.*\)$/) && inDialogue) {
          const cleaned = trimmed.slice(1, -1);
          html += `<div class="parenthetical">(${this.escapeHtml(cleaned)})</div>`;
        }
        else if (inDialogue) {
          html += `<div class="dialogue">${this.escapeHtml(trimmed)}</div>`;
        }
        else {
          html += `<div class="action">${this.escapeHtml(trimmed)}</div>`;
        }
      }

      return html;
    }

    private escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    private async save() {
      const content = this.editor.value;
      
      // Show saving state
      this.saveBtn.textContent = 'Saving...';
      this.saveBtn.disabled = true;

      try {
        // Emit custom event for parent to handle
        const event = new CustomEvent('scene-save', {
          detail: { sceneId: this.sceneId, content },
          bubbles: true
        });
        this.container.dispatchEvent(event);

        // For now, just download the file
        this.downloadScene(content);
        
        this.saveBtn.textContent = 'Saved!';
        setTimeout(() => this.close(), 1000);
      } catch (error) {
        console.error('Save failed:', error);
        this.saveBtn.textContent = 'Save Failed';
        this.saveBtn.disabled = false;
      }
    }

    private downloadScene(content: string) {
      const blob = new Blob([content], { type: 'text/markdown' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${this.sceneId}.mdx`;
      a.click();
      URL.revokeObjectURL(url);
    }

    private close() {
      this.container.remove();
    }
  }

  // Initialize editor
  document.addEventListener('DOMContentLoaded', () => {
    const editorEl = document.querySelector('.scene-editor');
    if (editorEl) {
      new SceneEditor(editorEl as HTMLElement);
    }
  });
</script>