---
import type { CollectionEntry } from "astro:content";
import BaseCard from "./BaseCard.astro";

interface Props {
  entry: CollectionEntry<"dreams">;
}

const { entry } = Astro.props;
const { data } = entry;

// Build meta array for BaseCard
const meta: string[] = [];
if (data.writtenAt) {
  meta.push(new Date(data.writtenAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    }));
}

// Estimate reading time (rough calculation: 200 words per minute)
const wordCount = data.wordCount || 1000; // Use provided word count or default
const readingTime = Math.ceil(wordCount / 200);

---
<BaseCard
  href={`/dreams/${entry.id}`}
  title={data.title}
  meta={meta}
  badge="Dream"
  badgeColor="var(--accent-blue)"
  class="dream-card"
  footer={`${readingTime} min read`}
  dataSet={typeof data.set === 'string' ? data.set : ''}
/>

<style>
  .dream-card {
    /* Dream-specific styling */
    --accent-blue: #3b82f6;
  }

  .dream-card .base-card__title {
    font-size: var(--text-lg);
    font-weight: 700;
    font-style: italic;
  }

  .dream-card .base-card__badge {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--accent-blue);
    color: white;
  }

  .dream-card .base-card__subtitle {
    color: var(--text-secondary);
    line-height: 1.6;
    font-style: italic;
  }

  .dream-card .base-card__footer-text {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
