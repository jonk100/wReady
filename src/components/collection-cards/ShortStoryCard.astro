---
/**
 * ShortStoryCard.astro
 *
 * Renders a single short story card using BaseCard as foundation.
 * Works specifically with short story collection entries.
 */

import type { CollectionEntry } from "astro:content";
import BaseCard from "./BaseCard.astro";

interface Props {
  entry: CollectionEntry<"short-stories">;
}

const { entry } = Astro.props;
const { data } = entry;

// Debug: Check if set data is being received
console.log('ShortStoryCard entry data:', data);

// Build meta array for BaseCard
const meta: string[] = [];
if (data.writtenAt) {
  meta.push(new Date(data.writtenAt).toLocaleDateString());
}

// Estimate reading time (rough calculation: 200 words per minute)
const wordCount = data.wordCount || 1000; // Use provided word count or default
const readingTime = Math.ceil(wordCount / 200);
---

<BaseCard
  href={`/short-stories/${entry.id}`}
  title={data.title}
  meta={meta}
  badge="Short Story"
  badgeColor="var(--accent-green)"
  footer={`${readingTime} min read`}
  class="short-story-card"
  dataSet={typeof data.set === 'string' ? data.set : ''}
/>

<style>
  .short-story-card {
    /* Short story-specific styling */
    --accent-green: #10b981;
  }

  .short-story-card .base-card__title {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .short-story-card .base-card__badge {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .short-story-card .base-card__subtitle {
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .short-story-card .base-card__footer-text {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
</style>
