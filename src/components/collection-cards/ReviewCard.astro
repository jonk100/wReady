---
/**
 * ReviewCard.astro
 *
 * Renders a single review card using BaseCard as foundation.
 * Works specifically with review collection entries.
 */

import type { CollectionEntry } from "astro:content";
import BaseCard from "./BaseCard.astro";

interface Props {
  entry: CollectionEntry<"reviews">;
}

const { entry } = Astro.props;
const { data } = entry;

// Helper to get status color
function getStatusColor(status: string) {
  switch (status) {
    case "published":
      return "var(--status-published)";
    case "draft":
      return "var(--status-draft)";
    default:
      return "var(--status-default)";
  }
}

// Build meta array for BaseCard
const meta: string[] = [];
if (data.category && data.year) {
  meta.push(`${data.category} · ${data.year}`);
} else if (data.category) {
  meta.push(data.category);
} else if (data.year) {
  meta.push(String(data.year));
}

if (data.finalScore) {
  meta.push(`${data.finalScore}/10`);
}

if (data.imdbRating) {
  meta.push(`${data.imdbRating}/10`);
}

// Build footer text
const footer: string[] = [];
if (data.channel) {
  footer.push(data.channel);
}
if (data.episodes) {
  footer.push(`${data.episodes} episodes`);
}
---

<BaseCard
  href={`/reviews/${entry.id}`}
  title={data.title}
  subtitle={data.subtitle}
  image={data.poster}
  imageAlt={`${data.title} poster`}
  badge={data.status}
  badgeColor={data.status ? getStatusColor(data.status) : undefined}
  meta={meta}
  footer={footer.length > 0 ? footer.join(" • ") : undefined}
  class="base-card--horizontal"
/>

<style>
  /* ── Base card ─────────────────────────────── */

  .base-card--horizontal {
    display: flex;
    flex-direction: row;
    align-items: stretch;
  }

  .base-card--horizontal .base-card__image-wrap {
    flex-shrink: 0;
    width: 160px;
    overflow: hidden;
  }

  .base-card--horizontal .base-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }

  .base-card--horizontal .base-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    flex: 1;
    min-width: 0; /* allow text truncation */
  }

  .base-card--horizontal .base-card__top {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    justify-content: space-between;
  }

  .base-card--horizontal .base-card__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
    /* Allow wrapping but limit to exactly 2 lines for consistency */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.6em; /* Ensure 2 lines always reserved */
  }

  .base-card--horizontal .base-card__badge {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--badge-color, var(--status-draft));
    border: 1px solid var(--badge-color, var(--status-draft));
    border-radius: var(--radius-sm);
    padding: 0.15em 0.5em;
    opacity: 0.85;
    white-space: nowrap;
    /* Align badge with first line of title */
    margin-top: 0.15em;
  }

  .base-card--horizontal .base-card__subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    /* Clamp to exactly 3 lines for consistency */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 4.5em; /* Ensure 3 lines always reserved */
  }

  .base-card--horizontal .base-card__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .base-card--horizontal .base-card__meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .base-card--horizontal .base-card__meta {
    font-size: var(--text-base);
    color: var(--text-muted);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .base-card--horizontal .base-card__rating {
    font-size: var(--text-base);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .base-card--horizontal .base-card__rating::before {
    content: "★";
    color: var(--accent);
  }
</style>
