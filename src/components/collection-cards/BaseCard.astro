---
/**
 * BaseCard.astro
 * 
 * A foundational card component that provides consistent styling
 * and structure for all collection cards (reviews, actors, etc.).
 * 
 * This component handles:
 * - Base card styling with hover effects
 * - Responsive grid layout
 * - Common card sections (image, content, footer)
 * - Accessibility features
 */

interface Props {
  href?: string;
  title: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  badge?: string;
  badgeColor?: string;
  meta?: string[];
  footer?: string;
  class?: string;
  dataSet?: string;
}

const {
  href,
  title,
  subtitle,
  image,
  imageAlt = title,
  badge,
  badgeColor = "var(--accent)",
  meta = [],
  footer,
  class: className = "",
  dataSet,
} = Astro.props;

const CardWrapper = href ? "a" : "div";
const cardClass = `base-card ${className}`.trim();
---

<CardWrapper 
  class={cardClass} 
  href={href}
  {...(href && { "aria-label": title })}
  {...(dataSet && { "data-set": dataSet })}
>
  {image && (
    <div class="base-card__image-wrap">
      <img 
        src={image} 
        alt={imageAlt}
        loading="lazy"
        class="base-card__image"
      />
    </div>
  )}

  <div class="base-card__body">
    <div class="base-card__top">
      <h3 class="base-card__title">{title}</h3>
      {badge && (
        <span 
          class="base-card__badge" 
          style={`background-color: ${badgeColor}`}
        >
          {badge}
        </span>
      )}
    </div>

    {subtitle && (
      <p class="base-card__subtitle">{subtitle}</p>
    )}

    {(meta.length > 0 || footer) && (
      <div class="base-card__footer">
        {meta.length > 0 && (
          <div class="base-card__meta">
            {meta.map((item) => (
              <span class="base-card__meta-item">{item}</span>
            ))}
          </div>
        )}
        {footer && (
          <div class="base-card__footer-text">{footer}</div>
        )}
      </div>
    )}
  </div>
</CardWrapper>

<style>
  .base-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-card);
    height: 100%;
  }

  .base-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .base-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .base-card--horizontal {
    flex-direction: row;
    align-items: flex-start;
  }

  .base-card__image-wrap {
    flex-shrink: 0;
    overflow: hidden;
  }

  .base-card--horizontal .base-card__image-wrap {
    width: 120px;
    height: 180px;
  }

  .base-card:not(.base-card--horizontal) .base-card__image-wrap {
    width: 100%;
    height: 200px;
  }

  .base-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .base-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    flex: 1;
    min-width: 0;
  }

  .base-card__top {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    justify-content: space-between;
  }

  .base-card__title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .base-card__badge {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
    color: var(--text-on-accent);
    text-transform: uppercase;
  }

  .base-card__subtitle {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .base-card__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
  }

  .base-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .base-card__meta-item {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }

  .base-card__footer-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .base-card--horizontal .base-card__image-wrap {
      width: 80px;
      height: 120px;
    }

    .base-card__body {
      padding: var(--space-4);
    }

    .base-card__title {
      font-size: var(--text-base);
    }

    .base-card__subtitle {
      font-size: var(--text-sm);
    }
  }
</style>
