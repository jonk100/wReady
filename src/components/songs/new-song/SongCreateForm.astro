---
import ChordVoicingSelector from "./ChordVoicingSelector.astro";
import SectionManager from "./SectionManager.astro";

export type Props = {
  /** Optional prefill values */
  initial?: {
    slug?: string;
    title?: string;
    keyRoot?: string;
    keyMode?: string;
    tempo?: string;
    timeSignatureTop?: string;
    timeSignatureBottom?: string;
    chordVoicings?: string;
    structure?: string;
    sections?: string;
    album?: string;
    chordSheetUrl?: string;
    status?: string;
    themes?: string;
    body?: string;
  };
};

const { initial } = Astro.props as Props;

const initialSlug                = initial?.slug                ?? "";
const initialTitle               = initial?.title               ?? "";
const initialKeyRoot             = initial?.keyRoot             ?? "C";
const initialKeyMode             = initial?.keyMode             ?? "major";
const initialTempo               = initial?.tempo               ?? 120;
const initialTimeSignatureTop    = initial?.timeSignatureTop    ?? 4;
const initialTimeSignatureBottom = initial?.timeSignatureBottom ?? 4;

const initialChordVoicings = JSON.stringify(initial?.chordVoicings ?? []);
const initialStructure     = JSON.stringify(initial?.structure ?? []);
const initialSections      = JSON.stringify(initial?.sections ?? [
  { name: "verse", chords: ["C", "G", "Am", "F"], bars: 8, repeats: 1 }
]);

const initialAlbum         = initial?.album         ?? "";
const initialChordSheetUrl = initial?.chordSheetUrl ?? "";
const initialStatus        = initial?.status        ?? "idea";
const initialThemes        = JSON.stringify(initial?.themes ?? []);
const initialBody          = initial?.body          ?? "";
---

<section class="create">
  <details>
    <summary class="create-summary">
      <div class="create-summary-content">
        <button class="create-reset-btn" type="button" title="Reset form">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
        </button>

        <span class="create-summary-text">Add a new song</span>

        <button class="create-toggle-btn" type="button" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    </summary>

    <form id="song-create-form" class="form">

      <!-- Basic Info -->
      <div class="section-group">
        <h3 class="section-title">Basic Information</h3>

        <div class="row">
          <label>
            <span>Title</span>
            <input name="title" type="text" required value={initialTitle} placeholder="Song title" />
          </label>

          <label>
            <span>Key Root</span>
            <select name="keyRoot" required>
              <option value="C"  selected={initialKeyRoot === "C"}>C</option>
              <option value="C#" selected={initialKeyRoot === "C#"}>C#</option>
              <option value="D"  selected={initialKeyRoot === "D"}>D</option>
              <option value="D#" selected={initialKeyRoot === "D#"}>D#</option>
              <option value="E"  selected={initialKeyRoot === "E"}>E</option>
              <option value="F"  selected={initialKeyRoot === "F"}>F</option>
              <option value="F#" selected={initialKeyRoot === "F#"}>F#</option>
              <option value="G"  selected={initialKeyRoot === "G"}>G</option>
              <option value="G#" selected={initialKeyRoot === "G#"}>G#</option>
              <option value="A"  selected={initialKeyRoot === "A"}>A</option>
              <option value="A#" selected={initialKeyRoot === "A#"}>A#</option>
              <option value="B"  selected={initialKeyRoot === "B"}>B</option>
            </select>
          </label>

          <label>
            <span>Key Mode</span>
            <select name="keyMode" required>
              <option value="major"      selected={initialKeyMode === "major"}>Major</option>
              <option value="minor"      selected={initialKeyMode === "minor"}>Minor</option>
              <option value="dorian"     selected={initialKeyMode === "dorian"}>Dorian</option>
              <option value="phrygian"   selected={initialKeyMode === "phrygian"}>Phrygian</option>
              <option value="lydian"     selected={initialKeyMode === "lydian"}>Lydian</option>
              <option value="mixolydian" selected={initialKeyMode === "mixolydian"}>Mixolydian</option>
            </select>
          </label>
        </div>

        <div class="row">
          <label>
            <span>Tempo (BPM)</span>
            <input name="tempo" type="number" min="60" max="200" value={String(initialTempo)} />
          </label>

          <label>
            <span>Time Signature</span>
            <div class="time-sig">
              <input name="timeSignatureTop"    type="number" min="1" max="16" required value={String(initialTimeSignatureTop)} />
              <span>/</span>
              <input name="timeSignatureBottom" type="number" min="1" max="16" required value={String(initialTimeSignatureBottom)} />
            </div>
          </label>
        </div>
      </div>

      <!-- Song Structure -->
      <div class="section-group">
        <h3 class="section-title">Song Structure</h3>

        <SectionManager
          initialSections={JSON.parse(initial?.sections || '[]')}
          initialStructure={JSON.parse(initial?.structure || '[]')}
        />

        <!-- Hidden inputs for form submission -->
        <input name="structure" type="hidden" value={initialStructure} />
        <input name="sections"  type="hidden" value={initialSections} />
      </div>

      <!-- Chord Voicings -->
      <div class="section-group">
        <h3 class="section-title">Chord Voicings</h3>

        <div class="row">
          <label class="grow">
            <span>Chord Voicings</span>
            <!--
              ChordVoicingSelector manages its own search/display state and
              dispatches 'chord-voicings-change' (bubbles: true) whenever the
              selection changes. The parent script below writes the slug array
              into the hidden input so FormData picks it up on submit.

              The parent script also keeps data-key-root in sync when the user
              changes the Key Root <select>, so chord colours update reactively.
            -->
            <ChordVoicingSelector
              initialVoicings={JSON.parse(initialChordVoicings)}
              keyRoot={initialKeyRoot}
            />
            <!--
              Hidden input stays here — owned by the form, not the component.
              ID used by the script below; name used by FormData on submit.
            -->
            <input
              name="chordVoicings"
              type="hidden"
              id="chord-voicings-hidden"
              value={initialChordVoicings}
            />
            <small>Type to search chords from your collection, click to select</small>
          </label>
        </div>
      </div>

      <!-- Optional Fields -->
      <div class="section-group">
        <h3 class="section-title">Optional</h3>

        <div class="row">
          <label>
            <span>Album</span>
            <input name="album" type="text" value={initialAlbum} placeholder="Album slug or title" />
          </label>

          <label>
            <span>Chord Sheet URL</span>
            <input name="chordSheetUrl" type="url" value={initialChordSheetUrl} placeholder="https://..." />
          </label>
        </div>

        <div class="row">
          <label>
            <span>Status</span>
            <select name="status">
              <option value="idea"     selected={initialStatus === "idea"}>Idea</option>
              <option value="demo"     selected={initialStatus === "demo"}>Demo</option>
              <option value="arranged" selected={initialStatus === "arranged"}>Arranged</option>
              <option value="recorded" selected={initialStatus === "recorded"}>Recorded</option>
              <option value="released" selected={initialStatus === "released"}>Released</option>
            </select>
          </label>

          <label class="grow">
            <span>Themes (JSON)</span>
            <input name="themes" type="text" value={initialThemes} placeholder='["love", "loss"]' />
          </label>
        </div>

        <div class="row">
          <label class="grow">
            <span>Lyrics / Body</span>
            <textarea name="body" rows="12" placeholder="Lyrics…">{initialBody}</textarea>
          </label>
        </div>
      </div>

      <!-- Slug -->
      <div class="row">
        <label class="grow">
          <span>Slug (auto-generated)</span>
          <input name="slug" type="text" value={initialSlug} placeholder="song-title" />
          <small>Auto-generated from title if empty</small>
        </label>
      </div>

      <div class="actions">
        <button type="submit">Generate song</button>
      </div>

      <p id="song-create-status" class="status" aria-live="polite"></p>

      <label class="output">
        <span>Generated MDX</span>
        <textarea id="song-create-output" rows="15" readonly></textarea>
      </label>

    </form>
  </details>
</section>

<script>
  // ---------------------------------------------------------------------------
  // Element refs
  // ---------------------------------------------------------------------------

  const form      = document.getElementById("song-create-form")     as HTMLFormElement;
  const statusEl  = document.getElementById("song-create-status")   as HTMLParagraphElement;
  const outputEl  = document.getElementById("song-create-output")   as HTMLTextAreaElement;
  const toggleBtn = document.querySelector(".create-toggle-btn")     as HTMLButtonElement;
  const resetBtn  = document.querySelector(".create-reset-btn")      as HTMLButtonElement;
  const details   = document.querySelector("details")                as HTMLDetailsElement;
  const titleField = form.querySelector('input[name="title"]')       as HTMLInputElement;
  const slugField  = form.querySelector('input[name="slug"]')        as HTMLInputElement;

  // ---------------------------------------------------------------------------
  // Chord Voicing Selector — hidden input + child event wiring
  // ---------------------------------------------------------------------------

  const chordVoicingsHidden = document.getElementById(
    "chord-voicings-hidden"
  ) as HTMLInputElement;

  /**
   * Keeps the hidden chordVoicings form input in sync with the
   * ChordVoicingSelector child component.
   *
   * The child dispatches 'chord-voicings-change' (bubbles: true) whenever
   * the user adds or removes a chord. We write the slug array into the
   * hidden input so FormData picks it up correctly on submit.
   */
  document.addEventListener("chord-voicings-change", (e: Event) => {
    const { slugs } = (e as CustomEvent<{ slugs: string[] }>).detail;
    chordVoicingsHidden.value = JSON.stringify(slugs);
  });

  // ---------------------------------------------------------------------------
  // Section Manager sync
  // ---------------------------------------------------------------------------

  /**
   * Keeps the hidden sections and structure inputs in sync with the
   * SectionManager child component.
   *
   * The child dispatches 'section-manager-change' (bubbles: true) whenever
   * the user modifies sections or structure. We write the values into the
   * hidden inputs so FormData picks them up correctly on submit.
   */
  document.addEventListener("section-manager-change", (e: Event) => {
    const { sections, structure } = (e as CustomEvent<{ sections: any[], structure: string[] }>).detail;
    const sectionsInput = document.querySelector('input[name="sections"]') as HTMLInputElement;
    const structureInput = document.querySelector('input[name="structure"]') as HTMLInputElement;
    if (sectionsInput) sectionsInput.value = JSON.stringify(sections);
    if (structureInput) structureInput.value = JSON.stringify(structure);
  });

  // ---------------------------------------------------------------------------
  // Key root → ChordVoicingSelector sync
  // ---------------------------------------------------------------------------

  const keyRootSelect  = form.querySelector<HTMLSelectElement>('select[name="keyRoot"]');
  const selectorRoot   = document.querySelector<HTMLElement>(".chord-voicing-selector");

  /**
   * Keeps the ChordVoicingSelector's data-key-root attribute in sync with
   * the Key Root <select> so chord colours update when the key changes,
   * without needing to re-mount the component.
   */
  keyRootSelect?.addEventListener("change", () => {
    if (selectorRoot && keyRootSelect.value) {
      selectorRoot.setAttribute("data-key-root", keyRootSelect.value);
    }
  });

  // ---------------------------------------------------------------------------
  // Details toggle
  // ---------------------------------------------------------------------------

  /**
   * Syncs the toggle button's aria-expanded attribute with the
   * open/closed state of the parent <details> element.
   */
  function syncToggle(): void {
    toggleBtn.setAttribute("aria-expanded", String(details.open));
  }

  toggleBtn.addEventListener("click", (e: MouseEvent) => {
    e.preventDefault();
    details.open = !details.open;
    syncToggle();
  });

  details.addEventListener("toggle", syncToggle);
  syncToggle();

  // ---------------------------------------------------------------------------
  // Reset
  // ---------------------------------------------------------------------------

  resetBtn.addEventListener("click", (e: MouseEvent) => {
    e.preventDefault();
    form.reset();
    // Reset the hidden chord voicings input — the ChordVoicingSelector will
    // clear its own display state via its own internal reset if needed, but
    // we clear the hidden input here so the form value is consistent.
    chordVoicingsHidden.value = "[]";
    setStatus("Form reset.");
    setTimeout(() => {
      outputEl.value = "";
      setStatus("");
    }, 1500);
  });

  // ---------------------------------------------------------------------------
  // Status helper
  // ---------------------------------------------------------------------------

  /**
   * Sets the text content of the status paragraph.
   * @param msg - Message to display, or empty string to clear.
   */
  function setStatus(msg: string): void {
    statusEl.textContent = msg;
  }

  // ---------------------------------------------------------------------------
  // Slug auto-generation
  // ---------------------------------------------------------------------------

  /**
   * Derives a URL-safe slug from the title field and writes it into
   * the slug field, but only when the slug field is empty (i.e. the
   * user hasn't typed their own).
   */
  function generateSlug(): void {
    if (slugField.value) return;
    const title = titleField.value.trim();
    if (!title) return;
    slugField.value =
      title
        .toLowerCase()
        .replace(/[^a-z0-9\s]/g, "")
        .replace(/\s+/g, "-")
        .replace(/-+/g, "-") + "-0";
  }

  titleField.addEventListener("input", generateSlug);

  // ---------------------------------------------------------------------------
  // Form submit
  // ---------------------------------------------------------------------------

  form.addEventListener("submit", async (e: SubmitEvent): Promise<void> => {
    e.preventDefault();
    outputEl.value = "";
    setStatus("Working…");

    const formData = new FormData(form);
    const rawData  = Object.fromEntries(formData.entries());

    try {
      // Import actions dynamically for Astro compatibility
      const { actions } = await import('astro:actions');
      
      // Prepare JSON payload for the action
      const payload = {
        slug: rawData.slug as string,
        title: rawData.title as string,
        keyRoot: rawData.keyRoot as string,
        keyMode: rawData.keyMode as "major" | "minor",
        tempo: rawData.tempo ? parseInt(rawData.tempo as string, 10) : undefined,
        timeSignatureTop: parseInt(rawData.timeSignatureTop as string, 10),
        timeSignatureBottom: parseInt(rawData.timeSignatureBottom as string, 10),
        chordVoicings: JSON.parse(rawData.chordVoicings as string || "[]"),
        structure: JSON.parse(rawData.structure as string || "[]"),
        sections: JSON.parse(rawData.sections as string || "[]"),
        album: rawData.album ? rawData.album as string : undefined,
        chordSheetUrl: rawData.chordSheetUrl ? rawData.chordSheetUrl as string : undefined,
        status: rawData.status as string || "idea",
        themes: JSON.parse(rawData.themes as string || "[]"),
        body: rawData.body ? rawData.body as string : undefined,
      };

      const { data, error } = await actions.createSong(payload);

      if (error) {
        setStatus(`Error: ${error.message || "Action failed"}`);
        return;
      }

      setStatus(`Success: ${data.message || `Song ${data.id} created`}`);

      if (data.success) {
        form.reset();
        chordVoicingsHidden.value = "[]";
        
        // This is the magic part: reload after successful action
        // to trigger fresh content rendering
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      }

    } catch (err) {
      setStatus(err instanceof Error ? err.message : String(err));
    }
  });
</script>

<style>
  .create {
    margin-bottom: var(--space-8);
    border: 1px solid #3a300f;
    border-radius: 6px;
    background: #1a1508;
    color: #d4bb88;
    font-family: "Courier New", "Courier", monospace;
    overflow: hidden;
  }

  .create-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px 6px;
    border-bottom: 1px solid #3a300f;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .create-summary::-webkit-details-marker {
    display: none;
  }

  .create-summary-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .create-summary-text {
    font-family: "Courier New", Courier, monospace;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: .15em;
    color: #d4bb88;
    text-align: center;
    text-transform: uppercase;
    flex: 1;
  }

  .create-reset-btn {
    background: transparent;
    border: 1px solid #3a300f;
    border-radius: 50%;
    color: #7a6a44;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    flex-shrink: 0;
  }

  .create-reset-btn:hover {
    color: #e8a030;
    border-color: #c8922a;
  }

  .create-toggle-btn {
    background: transparent;
    border: 1px solid #3a300f;
    border-radius: 50%;
    color: #7a6a44;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
    flex-shrink: 0;
  }

  .create-toggle-btn:hover {
    color: #e8a030;
    border-color: #c8922a;
  }

  details[open] .create-toggle-btn {
    transform: rotate(180deg);
  }

  .form {
    margin-top: var(--space-4);
    padding: 14px 20px 20px;
    display: grid;
    gap: var(--space-4);
    background: var(--surface-subtle);
    border-top: 1px solid #3a300f;
  }

  .section-group {
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #e8a030;
    margin: 0 0 var(--space-3) var(--space-2);
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  .time-sig {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .time-sig input {
    width: 60px;
  }

  .row {
    display: flex;
    gap: var(--space-4);
    align-items: flex-end;
    flex-wrap: wrap;
  }

  label {
    display: grid;
    gap: var(--space-2);
    min-width: 220px;
  }

  .grow {
    flex: 1;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  select {
    cursor: pointer;
  }

  textarea {
    font-family: var(--font-mono);
    resize: vertical;
    min-height: 120px;
  }

  small {
    display: block;
    margin-top: 4px;
    font-size: 0.75rem;
    color: #7a6a44;
    line-height: 1.3;
  }

  .actions {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }

  button[type="submit"] {
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--accent);
    color: white;
    font-weight: 700;
    cursor: pointer;
  }

  .status {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .output span {
    font-weight: 700;
  }

  /* Form styling overrides for dropdown readability */
  .create select {
    font-family: var(--font-body) !important;
    font-size: var(--text-base) !important;
    color: var(--text-primary) !important;
    background: var(--bg-raised) !important;
    border: 1px solid var(--border) !important;
    border-radius: var(--radius-md) !important;
    padding: 0.5rem 0.75rem !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease !important;
    appearance: none !important;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpath d='M6 9l6 6M6 6l6-6'/%3e%3c/svg%3e") !important;
    background-repeat: no-repeat !important;
    background-position: right 0.75rem center !important;
    background-size: 1rem !important;
    padding-right: 2.5rem !important;
  }

  .create select:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 3px rgba(232, 197, 71, 0.1);
  }

  .create select option {
    background: var(--bg-raised);
    color: var(--text-primary);
    padding: 0.5rem;
  }
</style>