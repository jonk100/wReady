---
interface Props {
  name: string;
  index: number;
  chords?: string[];
}

const { name, index, chords = [] } = Astro.props;
const id = `${name}-${index}`;
---

<div id={id} class="lyrics-section-header">
  <div class="header-main">
    <span class="section-label">{name}</span>
    {chords.length > 0 && (
      <div class="header-chords" aria-label={`${name} chord progression`}>
        {chords.map((chord: string) => (
          <span class="mini-chord">{chord}</span>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .lyrics-section-header {
    margin: var(--space-8) 0 var(--space-4) 0;
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--border);
    scroll-margin-top: var(--space-8);
  }

  .header-main {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .section-label {
    font-size: var(--text-sm);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    background: var(--bg-secondary);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .header-chords {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .mini-chord {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }
</style>
