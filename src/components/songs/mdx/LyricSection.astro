---
/**
 * LyricsSection.astro
 *
 * Wraps a block of lyrics for one named section (e.g. "verse", "chorus",
 * "instrumental-modulation"). Looks up the section definition from the
 * `sections` array passed down from the song frontmatter, and renders:
 *
 *  - A section label badge (always)
 *  - A chord progression bar (when the section has chords defined)
 *  - A slot for the actual lyrics (or a placeholder if the section has no
 *    lyric content, e.g. purely instrumental)
 *
 * Because MDX doesn't support passing arrays as JSX props easily, `sections`
 * must be serialised to a JSON string when passed from the MDX page. A helper
 * is provided below so you can do it inline.
 *
 * Usage (in MDX):
 *
 * ```mdx
 * ---
 * // In your .astro layout/page that wraps the MDX, pass sections as a prop.
 * // Or import directly and stringify in-MDX:
 * ---
 * import LyricsSection from '@/components/lyrics/LyricsSection.astro';
 *
 * export const sections = frontmatter.sections;
 *
 * <LyricsSection name="verse" {sections}>
 *   If i had a gun...
 * </LyricsSection>
 *
 * <LyricsSection name="instrumental-modulation" {sections} />
 * ```
 *
 * If you want to override which chords are displayed (e.g. show a subset),
 * you can pass `chords` directly as a prop and it takes precedence over
 * the looked-up section definition.
 *
 * @prop {string}    name       - Matches a section name in the sections array
 * @prop {Array}     [sections] - Full sections array from song frontmatter
 * @prop {string[]}  [chords]   - Override chord list (skips section lookup)
 * @prop {boolean}   [showChords=true] - Set false to suppress chord bar
 */

interface SectionDef {
  name: string;
  chords?: string[];
  bars?: number;
  repeats?: number;
}

interface Props {
  name: string;
  sections?: SectionDef[];
  chords?: string[];
  showChords?: boolean;
}

const { name, sections = [], chords: chordsOverride, showChords = true } =
  Astro.props;

/**
 * Looks up the matching section definition by name.
 * Returns undefined if not found.
 */
const sectionDef = sections.find((s) => s.name === name);

/**
 * Resolves the chord list to display:
 * - Use explicit override if provided
 * - Otherwise fall back to the section definition
 * - Otherwise nothing
 */
const chords: string[] = chordsOverride ?? sectionDef?.chords ?? [];

/**
 * Formats the chord progression into a readable string,
 * grouping chords into clusters of 4 separated by a middle dot.
 * e.g. ["Am","Am","Am","Am","E","E","E","E"] → "Am Am Am Am · E E E E"
 *
 * @param {string[]} chords - Array of chord names
 * @param {number}   groupSize - How many chords per group (default 4)
 * @returns {string}
 */
function formatChordBar(chords: string[], groupSize = 4): string {
  if (!chords.length) return '';
  const groups: string[][] = [];
  for (let i = 0; i < chords.length; i += groupSize) {
    groups.push(chords.slice(i, i + groupSize));
  }
  return groups.map((g) => g.join(' ')).join(' · ');
}

const chordBar = showChords && chords.length ? formatChordBar(chords) : null;

/**
 * True when the section has no slot content (e.g. pure instrumental).
 * We still render it so the structure is visible, but with a placeholder.
 */
const hasSlot = await Astro.slots.has('default');
---

<div class="ls-section">
  <div class="ls-section-header">
    <span class="ls-section-label">{name}</span>
    {chordBar && <span class="ls-chord-bar">{chordBar}</span>}
  </div>

  <div class="ls-lyrics">
    {hasSlot ? <slot /> : <span class="ls-no-lyrics">[instrumental]</span>}
  </div>
</div>

<style>
  .ls-section {
    margin-bottom: 2rem;
  }

  .ls-section-header {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }

  .ls-section-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    background: var(--color-background-secondary);
    border: 0.5px solid var(--color-border-tertiary);
    padding: 2px 8px;
    border-radius: 3px;
    white-space: nowrap;
  }

  .ls-chord-bar {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-tertiary);
    letter-spacing: 0.02em;
  }

  .ls-lyrics {
    /*
     * line-height must be generous enough to accommodate chord labels
     * that sit 1.2em above the baseline of the word they annotate.
     * 2.4 gives comfortable clearance; increase if your chord labels clip.
     */
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 2.6;
    color: var(--color-text-primary);

    /*
     * white-space: pre-line preserves your line breaks from MDX
     * without requiring explicit <br /> tags.
     */
    white-space: pre-line;
  }

  .ls-no-lyrics {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    font-style: italic;
  }
</style>