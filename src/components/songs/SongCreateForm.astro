---
import type { APIRoute } from "astro";

export type Props = {
  /** Optional prefill values */
  initial?: {
    slug?: string;
    title?: string;
    keyRoot?: string;
    keyMode?: string;
    tempo?: string;
    timeSignatureTop?: string;
    timeSignatureBottom?: string;
    chordVoicings?: string;
    structure?: string;
    sections?: string;
    album?: string;
    chordSheetUrl?: string;
    status?: string;
    themes?: string;
  };
};

const { initial } = Astro.props as Props;

const initialSlug = initial?.slug ?? "";
const initialTitle = initial?.title ?? "";
const initialKeyRoot = initial?.keyRoot ?? "C";
const initialKeyMode = initial?.keyMode ?? "major";
const initialTempo = initial?.tempo ?? 120;
const initialTimeSignatureTop = initial?.timeSignatureTop ?? 4;
const initialTimeSignatureBottom = initial?.timeSignatureBottom ?? 4;

const initialChordVoicings = JSON.stringify(initial?.chordVoicings ?? []);
const initialStructure = JSON.stringify(initial?.structure ?? []);
const initialSections = JSON.stringify(initial?.sections ?? [
  { name: "verse", chords: ["C", "G", "Am", "F"], bars: 8, repeats: 1 }
]);

const initialAlbum = initial?.album ?? "";
const initialChordSheetUrl = initial?.chordSheetUrl ?? "";
const initialStatus = initial?.status ?? "idea";
const initialThemes = JSON.stringify(initial?.themes ?? []);
---

<section class="create">
  <details>
    <summary class="create-summary">
      <div class="create-summary-content">
        <button class="create-reset-btn" type="button" title="Reset form">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
        </button>

        <span class="create-summary-text">Add a new song</span>

        <button class="create-toggle-btn" type="button" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    </summary>

    <form id="song-create-form" class="form">
      <!-- Basic Info -->
      <div class="section-group">
        <h3 class="section-title">Basic Information</h3>

        <div class="row">
          <label>
            <span>Title</span>
            <input name="title" type="text" required value={initialTitle} placeholder="Song title" />
          </label>

          <label>
            <span>Key Root</span>
            <select name="keyRoot" required>
              <option value="C" selected={initialKeyRoot === "C"}>C</option>
              <option value="C#" selected={initialKeyRoot === "C#"}>C#</option>
              <option value="D" selected={initialKeyRoot === "D"}>D</option>
              <option value="D#" selected={initialKeyRoot === "D#"}>D#</option>
              <option value="E" selected={initialKeyRoot === "E"}>E</option>
              <option value="F" selected={initialKeyRoot === "F"}>F</option>
              <option value="F#" selected={initialKeyRoot === "F#"}>F#</option>
              <option value="G" selected={initialKeyRoot === "G"}>G</option>
              <option value="G#" selected={initialKeyRoot === "G#"}>G#</option>
              <option value="A" selected={initialKeyRoot === "A"}>A</option>
              <option value="A#" selected={initialKeyRoot === "A#"}>A#</option>
              <option value="B" selected={initialKeyRoot === "B"}>B</option>
            </select>
          </label>

          <label>
            <span>Key Mode</span>
            <select name="keyMode" required>
              <option value="major" selected={initialKeyMode === "major"}>Major</option>
              <option value="minor" selected={initialKeyMode === "minor"}>Minor</option>
              <option value="dorian" selected={initialKeyMode === "dorian"}>Dorian</option>
              <option value="phrygian" selected={initialKeyMode === "phrygian"}>Phrygian</option>
              <option value="lydian" selected={initialKeyMode === "lydian"}>Lydian</option>
              <option value="mixolydian" selected={initialKeyMode === "mixolydian"}>Mixolydian</option>
            </select>
          </label>
        </div>

        <div class="row">
          <label>
            <span>Tempo (BPM)</span>
            <input name="tempo" type="number" min="60" max="200" value={String(initialTempo)} />
          </label>

          <label>
            <span>Time Signature</span>
            <div class="time-sig">
              <input name="timeSignatureTop" type="number" min="1" max="16" required value={String(initialTimeSignatureTop)} />
              <span>/</span>
              <input name="timeSignatureBottom" type="number" min="1" max="16" required value={String(initialTimeSignatureBottom)} />
            </div>
          </label>
        </div>
      </div>

      <!-- Song Structure -->
      <div class="section-group">
        <h3 class="section-title">Song Structure</h3>

        <div class="row">
          <label class="grow">
            <span>Structure (JSON)</span>
            <input name="structure" type="text" required value={initialStructure} placeholder='["verse", "chorus", "bridge"]' />
            <small>Section names in playback order</small>
          </label>
        </div>

        <div class="row">
          <label class="grow">
            <span>Sections (JSON)</span>
            <textarea name="sections" rows="6" required>{initialSections}</textarea>
            <small>Array of section objects with name, chords, bars, repeats</small>
          </label>
        </div>
      </div>

      <!-- Chord Voicings -->
      <div class="section-group">
        <h3 class="section-title">Chord Voicings</h3>

        <div class="row">
          <label class="grow">
            <span>Chord Voicings</span>
            <div class="chord-selector">
              <input
                id="chord-input"
                type="text"
                placeholder="Type chord name (e.g., am, g, c)"
                autocomplete="off"
              />
              <div id="chord-dropdown" class="chord-dropdown" style="display:none">
                <!-- Populated dynamically -->
              </div>
              <input name="chordVoicings" type="hidden" id="chord-voicings" value={initialChordVoicings} />
              <div id="selected-chords" class="selected-chords">
                <!-- Selected chord tags rendered here -->
              </div>
            </div>
            <small>Type to search chords from your collection, click to select</small>
          </label>
        </div>
      </div>

      <!-- Optional Fields -->
      <div class="section-group">
        <h3 class="section-title">Optional</h3>

        <div class="row">
          <label>
            <span>Album</span>
            <input name="album" type="text" value={initialAlbum} placeholder="Album slug or title" />
          </label>

          <label>
            <span>Chord Sheet URL</span>
            <input name="chordSheetUrl" type="url" value={initialChordSheetUrl} placeholder="https://..." />
          </label>
        </div>

        <div class="row">
          <label>
            <span>Status</span>
            <select name="status">
              <option value="idea" selected={initialStatus === "idea"}>Idea</option>
              <option value="demo" selected={initialStatus === "demo"}>Demo</option>
              <option value="arranged" selected={initialStatus === "arranged"}>Arranged</option>
              <option value="recorded" selected={initialStatus === "recorded"}>Recorded</option>
              <option value="released" selected={initialStatus === "released"}>Released</option>
            </select>
          </label>

          <label class="grow">
            <span>Themes (JSON)</span>
            <input name="themes" type="text" value={initialThemes} placeholder='["love", "loss"]' />
          </label>
        </div>
      </div>

      <!-- Slug -->
      <div class="row">
        <label class="grow">
          <span>Slug (auto-generated)</span>
          <input name="slug" type="text" value={initialSlug} placeholder="song-title" />
          <small>Auto-generated from title if empty</small>
        </label>
      </div>

      <div class="actions">
        <button type="submit">Generate song</button>
      </div>

      <p id="song-create-status" class="status" aria-live="polite"></p>

      <label class="output">
        <span>Generated MDX</span>
        <textarea id="song-create-output" rows="15" readonly></textarea>
      </label>
    </form>
  </details>
</section>

<script>
  // ---------------------------------------------------------------------------
  // Imports
  // ---------------------------------------------------------------------------
  
  import { DIATONIC_MAJOR_MAP } from "../../utils/music/musicTheory";

  // ---------------------------------------------------------------------------
  // Types
  // ---------------------------------------------------------------------------

  /** A single chord voicing returned from /api/chords/search */
  interface ChordOption {
    slug: string;
    displayName: string;
    voicingLabel: string;
  }

  // ---------------------------------------------------------------------------
  // Element refs
  // ---------------------------------------------------------------------------

  const form = document.getElementById("song-create-form") as HTMLFormElement;
  const statusEl = document.getElementById("song-create-status") as HTMLParagraphElement;
  const outputEl = document.getElementById("song-create-output") as HTMLTextAreaElement;
  const toggleBtn = document.querySelector(".create-toggle-btn") as HTMLButtonElement;
  const resetBtn = document.querySelector(".create-reset-btn") as HTMLButtonElement;
  const details = document.querySelector("details") as HTMLDetailsElement;
  const chordInput = document.getElementById("chord-input") as HTMLInputElement;
  const chordDropdown = document.getElementById("chord-dropdown") as HTMLDivElement;
  const chordVoicingsInput = document.getElementById("chord-voicings") as HTMLInputElement;
  const selectedChordsContainer = document.getElementById("selected-chords") as HTMLDivElement;
  const titleField = form.querySelector('input[name="title"]') as HTMLInputElement;
  const slugField = form.querySelector('input[name="slug"]') as HTMLInputElement;

  // ---------------------------------------------------------------------------
  // State
  // ---------------------------------------------------------------------------

  /** Currently selected chord voicings */
  let selectedChords: ChordOption[] = [];

  /** Get the current song key from form */
  function getCurrentKey(): string {
    const keyRootSelect = form.querySelector<HTMLSelectElement>('select[name="keyRoot"]');
    return keyRootSelect?.value || 'C';
  }

  /** Get chord function based on root relative to song key */
  function getChordFunction(chordRoot: string, songKey: string): { degree: string; quality: string } {
    // Convert minor chord notation (am, em, etc.) to root note
    let normalizedRoot = chordRoot;
    if (chordRoot.endsWith('m')) {
      normalizedRoot = chordRoot.slice(0, -1); // "am" -> "a"
    }
    
    const notes = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
    const keyIndex = notes.indexOf(songKey);
    const chordIndex = notes.indexOf(normalizedRoot);
    
    if (keyIndex === -1 || chordIndex === -1) return { degree: 'unknown', quality: 'major' };
    
    const interval = (chordIndex - keyIndex + 12) % 12;
    const diatonicIndex = Math.floor(interval / 2); // Convert to diatonic scale index
    
    if (diatonicIndex >= 0 && diatonicIndex < DIATONIC_MAJOR_MAP.length) {
      return DIATONIC_MAJOR_MAP[diatonicIndex];
    }
    
    return { degree: 'unknown', quality: 'major' };
  }

  /** Get color based on chord function using music theory */
  function getChordColor(chordFunction: { degree: string; quality: string }): { bg: string; text: string; border: string } {
    const colors: { [key: string]: { bg: string; text: string; border: string } } = {
      'I': { bg: '#e8a030', text: '#1a1508', border: '#d4bb88' },      // Tonic - Gold
      'ii': { bg: '#7a6a44', text: '#d4bb88', border: '#a09060' },    // Supertonic - Brown
      'iii': { bg: '#e8a0e8', text: '#1a1508', border: '#ff7aff' },   // Mediant - Purple
      'IV': { bg: '#3a9eff', text: '#1a1508', border: '#5ab3ff' },     // Subdominant - Blue  
      'V': { bg: '#e830a0', text: '#1a1508', border: '#ff5050' },      // Dominant - Red
      'vi': { bg: '#a0e8a0', text: '#1a1508', border: '#7aff7a' },    // Relative minor - Green
      'vii°': { bg: '#8a7a8a', text: '#1a1508', border: '#aaaaaa' },   // Leading tone - Gray
      'unknown': { bg: '#3a300f', text: '#d4bb88', border: '#5a4a2f' }  // Default
    };
    
    return colors[chordFunction.degree] || colors['unknown'];
  }

  // ---------------------------------------------------------------------------
  // Details toggle
  // ---------------------------------------------------------------------------

  /**
   * Syncs the toggle button's aria-expanded attribute with the
   * open/closed state of the parent <details> element.
   */
  function syncToggle(): void {
    toggleBtn.setAttribute("aria-expanded", String(details.open));
  }

  toggleBtn.addEventListener("click", (e: MouseEvent) => {
    e.preventDefault();
    details.open = !details.open;
    syncToggle();
  });

  details.addEventListener("toggle", syncToggle);
  syncToggle();

  // ---------------------------------------------------------------------------
  // Reset
  // ---------------------------------------------------------------------------

  resetBtn.addEventListener("click", (e: MouseEvent) => {
    e.preventDefault();
    form.reset();
    selectedChords = [];
    updateSelectedChordsDisplay();
    updateChordVoicingsInput();
    setStatus("Form reset.");
    setTimeout(() => {
      outputEl.value = "";
      setStatus("");
    }, 1500);
  });

  // ---------------------------------------------------------------------------
  // Status helper
  // ---------------------------------------------------------------------------

  /**
   * Sets the text content of the status paragraph.
   * @param msg - Message to display, or empty string to clear.
   */
  function setStatus(msg: string): void {
    statusEl.textContent = msg;
  }

  // ---------------------------------------------------------------------------
  // Slug auto-generation
  // ---------------------------------------------------------------------------

  /**
   * Derives a URL-safe slug from the title field and writes it into
   * the slug field, but only when the slug field is empty (i.e. the
   * user hasn't typed their own).
   */
  function generateSlug(): void {
    if (slugField.value) return;
    const title = titleField.value.trim();
    if (!title) return;
    slugField.value =
      title
        .toLowerCase()
        .replace(/[^a-z0-9\s]/g, "")
        .replace(/\s+/g, "-")
        .replace(/-+/g, "-") + "-0";
  }

  titleField.addEventListener("input", generateSlug);

  // ---------------------------------------------------------------------------
  // Chord search — live API fetch
  // ---------------------------------------------------------------------------

  /** Timer handle used to debounce the search input */
  let debounceTimer: ReturnType<typeof setTimeout> | null = null;

  /**
   * Fetches matching chords from /api/chords/search and renders them
   * in the dropdown. Called on every keystroke (debounced).
   */
  async function updateChordDropdown(): Promise<void> {
    const query = chordInput.value.trim();

    console.log(`🔍 Frontend search for: "${query}"`);

    if (!query) {
      chordDropdown.innerHTML = "";
      chordDropdown.style.display = "none";
      return;
    }

    // Show a loading state while the fetch is in flight
    chordDropdown.innerHTML = '<div class="no-results">Searching…</div>';
    chordDropdown.style.display = "block";

    try {
      const res = await fetch(`/api/chords/search?q=${encodeURIComponent(query)}`);
      if (!res.ok) throw new Error(`Search failed: ${res.status}`);

      const json = (await res.json()) as { chords: ChordOption[] };
      const results = json.chords;

      console.log(`📦 API returned ${results.length} chords`);

      if (results.length === 0) {
        chordDropdown.innerHTML = '<div class="no-results">No chords found</div>';
        return;
      }

      const songKey = getCurrentKey();
      console.log(`🎵 Current song key: ${songKey}`);
      
      chordDropdown.innerHTML = results
        .map(
          (chord) => {
            const chordRoot = chord.displayName.split(' ')[0];
            const chordFunction = getChordFunction(chordRoot, songKey);
            const colors = getChordColor(chordFunction);
            
            console.log(`🎨 Chord: ${chord.displayName} -> Function: ${chordFunction.degree} -> Color: ${colors.bg}`);
            
            return `<div class="chord-option" data-slug="${chord.slug}" style="background: ${colors.bg}; border-left: 3px solid ${colors.border};">
              <div class="chord-name" style="color: ${colors.text}">${chord.displayName} (${chord.voicingLabel})</div>
            </div>`;
          }
        )
        .join("");
    } catch (err) {
      chordDropdown.innerHTML = '<div class="no-results">Error loading chords</div>';
      console.error("Chord search error:", err);
    }
  }

  /**
   * Debounced wrapper around updateChordDropdown.
   * Waits 200 ms after the last keystroke before firing the fetch.
   */
  function handleChordInput(): void {
    if (debounceTimer !== null) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(updateChordDropdown, 200);
  }

  chordInput.addEventListener("input", handleChordInput);

  // Also show results immediately on focus if there's already a value
  chordInput.addEventListener("focus", () => {
    if (chordInput.value.trim()) updateChordDropdown();
  });

  // ---------------------------------------------------------------------------
  // Chord selection
  // ---------------------------------------------------------------------------

  /**
   * Adds a chord to the selected list if it isn't already present,
   * then clears the input and hides the dropdown.
   * @param chord - The chord option to add.
   */
  function addChord(chord: ChordOption): void {
    if (selectedChords.find((c) => c.slug === chord.slug)) return;
    selectedChords.push(chord);
    updateSelectedChordsDisplay();
    updateChordVoicingsInput();
    chordInput.value = "";
    chordDropdown.style.display = "none";
  }

  /**
   * Removes a chord from the selected list by its slug.
   * @param slug - The slug of the chord to remove.
   */
  function removeChord(slug: string): void {
    selectedChords = selectedChords.filter((c) => c.slug !== slug);
    updateSelectedChordsDisplay();
    updateChordVoicingsInput();
  }

  /**
   * Re-renders the selected chord tags in the DOM and re-attaches
   * the remove button listeners.
   */
  function updateSelectedChordsDisplay(): void {
    const songKey = getCurrentKey();
    
    selectedChordsContainer.innerHTML = selectedChords
      .map(
        (chord) => {
          const chordRoot = chord.displayName.split(' ')[0];
          const chordFunction = getChordFunction(chordRoot, songKey);
          const colors = getChordColor(chordFunction);
          
          return `<div class="selected-chord-tag" data-slug="${chord.slug}" style="background: ${colors.bg}; border: 1px solid ${colors.border};">
            <span class="chord-tag-text" style="color: ${colors.text}">${chord.displayName} (${chord.voicingLabel})</span>
            <button class="remove-chord" data-slug="${chord.slug}" type="button" aria-label="Remove ${chord.displayName}" style="color: ${colors.text};">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>`;
        }
      )
      .join("");

    selectedChordsContainer.querySelectorAll<HTMLButtonElement>(".remove-chord").forEach((btn) => {
      btn.addEventListener("click", (e: MouseEvent) => {
        e.preventDefault();
        const slug = (e.currentTarget as HTMLButtonElement).getAttribute("data-slug")!;
        removeChord(slug);
      });
    });
  }

  /**
   * Serialises the selected chord slugs into the hidden form input
   * so they are included when the form is submitted.
   */
  function updateChordVoicingsInput(): void {
    chordVoicingsInput.value = JSON.stringify(selectedChords.map((c) => c.slug));
  }

  // Handle clicks on dropdown options (event delegation)
  chordDropdown.addEventListener("click", (e: MouseEvent) => {
    const option = (e.target as HTMLElement).closest<HTMLElement>(".chord-option");
    if (!option) return;
    const slug = option.getAttribute("data-slug")!;
    const displayName = option.querySelector(".chord-name")?.textContent ?? slug;
    const voicingLabel = option.querySelector(".chord-details")?.textContent ?? "";
    addChord({ slug, displayName, voicingLabel });
  });

  // Close dropdown when clicking outside the selector
  document.addEventListener("click", (e: MouseEvent) => {
    if (
      !chordDropdown.contains(e.target as Node) &&
      e.target !== chordInput
    ) {
      chordDropdown.style.display = "none";
    }
  });

  // ---------------------------------------------------------------------------
  // Initialise selected chords from prefill prop
  // ---------------------------------------------------------------------------

  /**
   * If the component was rendered with initial chordVoicings, resolve
   * each slug against the API so we have full displayName/voicingLabel
   * data, then render the tags.
   */
  async function initSelectedChords(): Promise<void> {
    const rawValue = chordVoicingsInput.value;
    if (!rawValue || rawValue === "[]") return;

    let slugs: string[];
    try {
      slugs = JSON.parse(rawValue) as string[];
    } catch {
      console.error("Failed to parse initial chordVoicings:", rawValue);
      return;
    }

    if (slugs.length === 0) return;

    // Fetch each slug individually so we get accurate display data.
    // In practice prefill sets are small so individual fetches are fine.
    const resolved = await Promise.all(
      slugs.map(async (slug): Promise<ChordOption> => {
        try {
          const res = await fetch(`/api/chords/search?q=${encodeURIComponent(slug)}`);
          const json = (await res.json()) as { chords: ChordOption[] };
          // Find exact slug match
          return (
            json.chords.find((c) => c.slug === slug) ?? {
              slug,
              displayName: slug,
              voicingLabel: "Unknown",
            }
          );
        } catch {
          return { slug, displayName: slug, voicingLabel: "Unknown" };
        }
      })
    );

    selectedChords = resolved;
    updateSelectedChordsDisplay();
  }

  initSelectedChords();

  // ---------------------------------------------------------------------------
  // Form submit
  // ---------------------------------------------------------------------------

  form.addEventListener("submit", async (e: SubmitEvent): Promise<void> => {
    e.preventDefault();
    outputEl.value = "";
    setStatus("Working…");

    const data = new FormData(form);

    try {
      // Import actions dynamically for Astro compatibility
      const { actions } = await import('astro:actions');
      
      // Convert FormData to object for action
      const rawData = Object.fromEntries(data.entries());
      
      // Send JSON data directly to the action
      const payload = {
        slug: rawData.slug as string,
        title: rawData.title as string,
        keyRoot: rawData.keyRoot as string,
        keyMode: rawData.keyMode as "major" | "minor",
        tempo: rawData.tempo ? parseInt(rawData.tempo as string, 10) : undefined,
        timeSignatureTop: parseInt(rawData.timeSignatureTop as string, 10),
        timeSignatureBottom: parseInt(rawData.timeSignatureBottom as string, 10),
        chordVoicings: JSON.parse(rawData.chordVoicings as string || "[]"),
        structure: JSON.parse(rawData.structure as string || "[]"),
        sections: JSON.parse(rawData.sections as string || "[]"),
        album: typeof rawData.album === 'string' ? rawData.album : undefined,
        chordSheetUrl: typeof rawData.chordSheetUrl === 'string' ? rawData.chordSheetUrl : undefined,
        status: rawData.status as string || "idea",
        themes: JSON.parse(rawData.themes as string || "[]"),
        body: rawData.body as string || "",
      };

      const { data: actionResult, error } = await actions.createSong(payload);

      if (error) {
        setStatus(error.message ?? "Action failed");
        return;
      }

      if (actionResult.success) {
        setStatus(actionResult.message || "Song created successfully");
        
        // This is the magic part: reload after successful action
        // to trigger fresh content rendering
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      }
    } catch (err) {
      setStatus(err instanceof Error ? err.message : String(err));
    }
  });
</script>

<style>
  .create {
    margin-bottom: var(--space-8);
    border: 1px solid #3a300f;
    border-radius: 6px;
    background: #1a1508;
    color: #d4bb88;
    font-family: "Courier New", "Courier", monospace;
    overflow: hidden;
  }

  .create-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px 6px;
    border-bottom: 1px solid #3a300f;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .create-summary::-webkit-details-marker {
    display: none;
  }

  .create-summary-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .create-summary-text {
    font-family: "Courier New", Courier, monospace;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: .15em;
    color: #d4bb88;
    text-align: center;
    text-transform: uppercase;
    flex: 1;
  }

  .create-reset-btn {
    background: transparent;
    border: 1px solid #3a300f;
    border-radius: 50%;
    color: #7a6a44;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    flex-shrink: 0;
